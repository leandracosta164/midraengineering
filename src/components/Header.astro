---
const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<header class="site-header" id="site-header">
  <div class="container">

    <div class="header-inner">

      <!-- Logo -->

      <a
        href="/"
        class="logo"
        aria-label="MIDRA Engineering"
      >
        <img
          src="/images/branding/midra-logo.png"
          alt="MIDRA Engineering"
          width="220"
          height="70"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <!-- Desktop Navigation -->

      <nav
        class="desktop-nav"
        aria-label="Primary Navigation"
      >
        {
          navigation.map((item) => {

            const active =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);

            return (

              <a
                href={item.href}
                class:list={[
                  "nav-link",
                  { active }
                ]}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
              </a>

            );

          })
        }
      </nav>

      <!-- Call To Action -->

      <a
        href="/contact"
        class="proposal-button"
      >
        Request Proposal
      </a>

      <!-- Mobile Toggle -->

      <button
        id="mobile-toggle"
        class="mobile-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>
</header>

<div
  id="mobile-menu"
  class="mobile-menu"
>

  <nav aria-label="Mobile Navigation">

    {
      navigation.map((item) => {

        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return (

          <a
            href={item.href}
            class:list={[
              "mobile-link",
              { active }
            ]}
            aria-current={active ? "page" : undefined}
          >
            {item.label}
          </a>

        );

      })
    }

    <a
      href="/contact"
      class="mobile-button"
    >
      Request Proposal
    </a>

  </nav>

</div>

<script>

const header = document.getElementById("site-header");
const toggle = document.getElementById("mobile-toggle");
const menu = document.getElementById("mobile-menu");

function closeMenu() {

  if (!toggle || !menu) return;

  toggle.classList.remove("open");
  menu.classList.remove("open");

  toggle.setAttribute(
    "aria-expanded",
    "false"
  );

}

toggle?.addEventListener("click", () => {

  if (!menu) return;

  const open = menu.classList.toggle("open");

  toggle.classList.toggle("open", open);

  toggle.setAttribute(
    "aria-expanded",
    String(open)
  );

});

window.addEventListener("resize", () => {

if (window.innerWidth > 768) {
    closeMenu();
}

});

document
  .querySelectorAll(".mobile-menu a")
  .forEach((link) => {

    link.addEventListener(
      "click",
      closeMenu
    );

  });

window.addEventListener("scroll", () => {

  if (!header) return;

  header.classList.toggle(
    "scrolled",
    window.scrollY > 8
  );

});

</script>

<style>
/* ==========================================================
   MIDRA ENGINEERING
   Header Styles
   ========================================================== */

.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;

  width: 100%;
  background: #ffffff;

  border-bottom: 1px solid rgba(8, 41, 94, 0.08);

  transition:
    background-color .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.site-header.scrolled {
  background: rgba(255,255,255,.98);
  box-shadow: 0 10px 28px rgba(8,41,94,.08);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;

  height: 88px;
  gap: 48px;
}

/* ===========================
   Logo
=========================== */

.logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.logo img {
  display: block;
  height: 60px;
  width: auto;
}

/*
---------------------------------------------------

NO LOGO ANIMATION

No hover.

No transition.

No scale.

No rotation.

The logo remains completely static.

---------------------------------------------------
*/

/* ===========================
   Desktop Navigation
=========================== */

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 36px;
  margin-left: auto;
}

.nav-link {
  position: relative;

  color: #1F2937;

  font-family: "Inter", sans-serif;
  font-size: 15px;
  font-weight: 600;

  letter-spacing: .02em;

  text-decoration: none;

  transition: color .2s ease;
}

.nav-link:hover {
  color: #08295E;
}

.nav-link.active {
  color: #08295E;
}

.nav-link::after {

  content: "";

  position: absolute;

  left: 0;
  bottom: -12px;

  width: 100%;
  height: 3px;

  background: #C89B3C;

  transform: scaleX(0);

  transform-origin: left;

  transition: transform .22s ease;

}

.nav-link:hover::after,
.nav-link.active::after {

  transform: scaleX(1);

}

/* ===========================
   CTA
=========================== */

.proposal-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 52px;
    padding: 0 24px;   /* was 30px */

    white-space: nowrap;

    border-radius: 999px;
    background: #08295E;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
}

.proposal-button:hover {

  background: #103D82;

  transform: translateY(-1px);

  box-shadow:
    0 16px 34px rgba(8,41,94,.16);

}

.proposal-button:focus-visible,
.nav-link:focus-visible {

  outline: 3px solid #C89B3C;

  outline-offset: 4px;

}

/* ===========================
   Mobile Toggle
=========================== */

.mobile-toggle {

  display: none;

  width: 42px;
  height: 34px;

  position: relative;

  border: none;
  background: transparent;

  cursor: pointer;

}

.mobile-toggle span {

  position: absolute;

  left: 0;

  width: 100%;

  height: 3px;

  border-radius: 999px;

  background: #08295E;

  transition:
    transform .25s ease,
    opacity .25s ease,
    top .25s ease;

}

.mobile-toggle span:nth-child(1) {
  top: 5px;
}

.mobile-toggle span:nth-child(2) {
  top: 15px;
}

.mobile-toggle span:nth-child(3) {
  top: 25px;
}

.mobile-toggle.open span:nth-child(1) {
  top: 15px;
  transform: rotate(45deg);
}

.mobile-toggle.open span:nth-child(2) {
  opacity: 0;
}

.mobile-toggle.open span:nth-child(3) {
  top: 15px;
  transform: rotate(-45deg);
}
/* ==========================================================
   Mobile Navigation
   ========================================================== */

.mobile-menu {

  position: fixed;

  top: 88px;
  left: 0;
  right: 0;

  background: #ffffff;

  border-bottom: 1px solid rgba(8,41,94,.08);

  box-shadow:
    0 20px 40px rgba(8,41,94,.08);

  opacity: 0;
  visibility: hidden;

  transform: translateY(-16px);

  transition:
    opacity .25s ease,
    visibility .25s ease,
    transform .25s ease;

  z-index: 999;

}

.mobile-menu.open {

  opacity: 1;
  visibility: visible;

  transform: translateY(0);

}

.mobile-menu nav {

  display: flex;
  flex-direction: column;

  padding: 32px 24px;

  gap: 8px;

}

.mobile-link {

  display: block;

  padding: 14px 0;

  font-size: 16px;

  font-weight: 600;

  color: #1F2937;

  text-decoration: none;

  border-bottom: 1px solid rgba(8,41,94,.05);

  transition:
    color .2s ease,
    padding-left .2s ease;

}

.mobile-link:hover,
.mobile-link.active {

  color: #08295E;

  padding-left: 10px;

}

.mobile-button {

  display: flex;

  justify-content: center;
  align-items: center;

  margin-top: 20px;

  height: 52px;

  border-radius: 999px;

  background: #08295E;

  color: #ffffff;

  text-decoration: none;

  font-weight: 700;

  transition:
    background-color .2s ease;

}

.mobile-button:hover {

  background: #103D82;

}

/* ==========================================================
   Responsive
   ========================================================== */

@media (max-width: 768px) {

  .desktop-nav,
  .proposal-button {
    display: none;
  }

  .mobile-toggle {
    display: block;
    margin-left: auto;
  }

  .header-inner {
    height: 80px;
  }

  .logo img {
    height: 54px;
  }

}

@media (max-width: 640px) {

  .header-inner {

    height: 72px;

  }

  .logo img {

    height: 48px;

  }

  .mobile-menu {

    top: 72px;

  }

}

/* ==========================================================
   Accessibility
   ========================================================== */

@media (prefers-reduced-motion: reduce) {

  * {

    animation: none !important;

    transition: none !important;

    scroll-behavior: auto !important;

  }

}
/* ==========================================================
   Focus States
   ========================================================== */

.logo:focus-visible,
.mobile-toggle:focus-visible,
.mobile-link:focus-visible,
.mobile-button:focus-visible {

  outline: 3px solid #C89B3C;
  outline-offset: 4px;

  border-radius: 6px;

}

/* ==========================================================
   Improve Image Rendering
   ========================================================== */

.logo img {

  image-rendering: auto;

  user-select: none;

  -webkit-user-drag: none;

}

/* ==========================================================
   Prevent Horizontal Overflow
   ========================================================== */

html,
body {

  overflow-x: hidden;

}

/* ==========================================================
   Better Touch Targets
   ========================================================== */

@media (pointer: coarse) {

  .nav-link,
  .mobile-link {

    min-height: 44px;

    display: flex;

    align-items: center;

  }

  .proposal-button,
  .mobile-button {

    min-height: 52px;

  }

}

/* ==========================================================
   Printing
   ========================================================== */

@media print {

  .site-header,
  .mobile-menu {

    display: none;

  }

}

</style>
