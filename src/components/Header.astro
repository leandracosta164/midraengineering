---
const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<header
  class="site-header"
  id="siteHeader"
>

  <div class="header-glass"></div>

  <div class="container">

    <div class="header-inner">

      <a
        href="/"
        class="logo"
        aria-label="MIDRA Engineering"
      >

        <img
          src="/midra-logo-transparent.png"
          alt="MIDRA Engineering"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />

      </a>

      <nav
        class="desktop-nav"
        aria-label="Primary Navigation"
      >

        {

          navigation.map((item)=>{

            const active =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);

            return(

              <a
                href={item.href}
                class={active ? "active" : ""}
                aria-current={active ? "page" : undefined}
              >

                {item.label}

              </a>

            );

          })

        }

      </nav>

      <a
        href="/contact"
        class="proposal-btn"
      >

        Request Proposal

      </a>

      <button
        id="mobileToggle"
        class="mobile-toggle"
        type="button"
        aria-label="Open Navigation"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >

        <span></span>

        <span></span>

        <span></span>

      </button>

    </div>

  </div>

</header>
<div
  id="mobileMenu"
  class="mobile-menu"
>

  <nav aria-label="Mobile Navigation">

    {

      navigation.map((item)=>{

        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return(

          <a
            href={item.href}
            class={active ? "active" : ""}
            aria-current={active ? "page" : undefined}
          >

            {item.label}

          </a>

        );

      })

    }

    <a
      href="/contact"
      class="mobile-proposal"
    >

      Request Proposal

    </a>

  </nav>

</div>

<script>

const header = document.getElementById("siteHeader");

const toggle = document.getElementById("mobileToggle");

const menu = document.getElementById("mobileMenu");

function closeMenu(){

  if(!toggle || !menu) return;

  toggle.classList.remove("open");

  menu.classList.remove("open");

  toggle.setAttribute("aria-expanded","false");

}

toggle?.addEventListener("click",()=>{

  if(!menu) return;

  const open = menu.classList.toggle("open");

  toggle.classList.toggle("open",open);

  toggle.setAttribute("aria-expanded",String(open));

});

window.addEventListener("resize",()=>{

  if(window.innerWidth>960){

    closeMenu();

  }

});

document
  .querySelectorAll(".mobile-menu a")
  .forEach(link=>{

    link.addEventListener("click",closeMenu);

  });

window.addEventListener("scroll",()=>{

  if(!header) return;

  if(window.scrollY>24){

    header.classList.add("scrolled");

  }else{

    header.classList.remove("scrolled");

  }

});

</script>

<style>

:root{

  --navy:#0E3153;

  --gold:#B68A35;

  --text:#263342;

  --border:#E9EDF3;

}

.site-header{

  position:fixed;

  top:22px;

  left:22px;

  right:22px;

  z-index:5000;

  border-radius:18px;

  overflow:hidden;

  background:rgba(255,255,255,.94);

  backdrop-filter:blur(18px);

  -webkit-backdrop-filter:blur(18px);

  border:1px solid rgba(255,255,255,.55);

  box-shadow:

    0 20px 50px rgba(13,33,58,.10);

  transition:

    top .30s ease,

    box-shadow .30s ease,

    background .30s ease;

}

.site-header.scrolled{

  top:12px;

  background:rgba(255,255,255,.97);

  box-shadow:

    0 26px 60px rgba(13,33,58,.16);

}

.header-glass{

  position:absolute;

  inset:0;

  pointer-events:none;

  background:

    linear-gradient(

      180deg,

      rgba(255,255,255,.38),

      rgba(255,255,255,.08)

    );

}

.container{

  width:min(1320px,92%);

  margin:auto;

}

.header-inner{

  height:86px;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:38px;

}

.logo{

  display:flex;

  align-items:center;

  flex-shrink:0;

  text-decoration:none;

}

.logo img{

  display:block;

  height:56px;

  width:auto;

  transition:

    transform .28s ease;

}

.logo:hover img{

  transform:scale(1.02);

}

.desktop-nav{

  display:flex;

  align-items:center;

  gap:42px;

  margin-left:auto;

}
.desktop-nav a{

  position:relative;

  display:flex;

  align-items:center;

  height:86px;

  text-decoration:none;

  color:var(--text);

  font-size:.96rem;

  font-weight:600;

  letter-spacing:.02em;

  transition:

    color .25s ease;

}

.desktop-nav a::after{

  content:"";

  position:absolute;

  left:50%;

  bottom:18px;

  transform:translateX(-50%);

  width:0;

  height:2px;

  border-radius:999px;

  background:var(--gold);

  transition:

    width .25s ease;

}

.desktop-nav a:hover{

  color:var(--navy);

}

.desktop-nav a:hover::after,
.desktop-nav a.active::after{

  width:100%;

}

.desktop-nav a.active{

  color:var(--navy);

}

.proposal-btn{

  display:inline-flex;

  align-items:center;

  justify-content:center;

  height:54px;

  min-width:220px;

  padding:0 34px;

  border-radius:999px;

  background:var(--navy);

  color:#ffffff;

  text-decoration:none;

  font-size:.95rem;

  font-weight:700;

  letter-spacing:.02em;

  box-shadow:

    0 14px 34px rgba(14,49,83,.18);

  transition:

    transform .25s ease,

    box-shadow .25s ease,

    background .25s ease;

}

.proposal-btn:hover{

  transform:translateY(-2px);

  box-shadow:

    0 20px 44px rgba(14,49,83,.24);

}

.proposal-btn:focus-visible,
.desktop-nav a:focus-visible,
.mobile-toggle:focus-visible{

  outline:2px solid var(--gold);

  outline-offset:4px;

  border-radius:8px;

}

.mobile-toggle{

  display:none;

  width:40px;

  height:32px;

  padding:0;

  border:none;

  background:none;

  cursor:pointer;

  position:relative;

  flex-shrink:0;

}

.mobile-toggle span{

  position:absolute;

  left:0;

  width:100%;

  height:3px;

  border-radius:999px;

  background:var(--navy);

  transition:.30s;

}

.mobile-toggle span:nth-child(1){

  top:4px;

}

.mobile-toggle span:nth-child(2){

  top:14px;

}

.mobile-toggle span:nth-child(3){

  top:24px;

}

.mobile-toggle.open span:nth-child(1){

  top:14px;

  transform:rotate(45deg);

}

.mobile-toggle.open span:nth-child(2){

  opacity:0;

}

.mobile-toggle.open span:nth-child(3){

  top:14px;

  transform:rotate(-45deg);

}

.mobile-menu{

  position:fixed;

  top:122px;

  left:22px;

  right:22px;

  border-radius:18px;

  overflow:hidden;

  background:rgba(255,255,255,.98);

  backdrop-filter:blur(18px);

  -webkit-backdrop-filter:blur(18px);

  border:1px solid var(--border);

  box-shadow:

    0 24px 54px rgba(12,25,45,.12);

  transform:translateY(-120%);

  opacity:0;

  visibility:hidden;

  transition:

    transform .30s ease,

    opacity .30s ease,

    visibility .30s ease;

  z-index:4900;

}

.mobile-menu.open{

  transform:translateY(0);

  opacity:1;

  visibility:visible;

}

.mobile-menu nav{

  display:flex;

  flex-direction:column;

  align-items:center;

  gap:22px;

  padding:34px;

}

.mobile-menu a{

  color:var(--text);

  text-decoration:none;

  font-size:1.02rem;

  font-weight:600;

  transition:

    color .20s ease,

    transform .20s ease;

}

.mobile-menu a:hover,
.mobile-menu a.active{

  color:var(--gold);

  transform:translateY(-2px);

}

.mobile-proposal{

  display:flex;

  align-items:center;

  justify-content:center;

  width:100%;

  max-width:260px;

  height:50px;

  margin-top:10px;

  border-radius:999px;

  background:var(--navy);

  color:#ffffff !important;

  text-decoration:none;

  font-weight:700;

  box-shadow:

    0 14px 34px rgba(14,49,83,.16);

}
.mobile-proposal:hover{

  transform:translateY(-2px);

  box-shadow:

    0 20px 44px rgba(14,49,83,.22);

}

.mobile-proposal:focus-visible,
.mobile-menu a:focus-visible{

  outline:2px solid var(--gold);

  outline-offset:4px;

  border-radius:8px;

}

@media (max-width:960px){

  .desktop-nav,
  .proposal-btn{

    display:none;

  }

  .mobile-toggle{

    display:block;

    margin-left:auto;

  }

  .site-header{

    top:16px;

    left:16px;

    right:16px;

    border-radius:16px;

  }

  .header-inner{

    height:78px;

  }

  .logo img{

    height:48px;

  }

  .mobile-menu{

    top:108px;

    left:16px;

    right:16px;

  }

}

@media (max-width:640px){

  .site-header{

    top:10px;

    left:10px;

    right:10px;

    border-radius:14px;

  }

  .header-inner{

    height:70px;

  }

  .logo img{

    height:42px;

  }

  .mobile-menu{

    top:92px;

    left:10px;

    right:10px;

  }

  .mobile-menu nav{

    padding:28px 22px;

    gap:18px;

  }

  .mobile-proposal{

    max-width:100%;

    height:48px;

  }

}

html{

  scroll-behavior:smooth;

}

body{

  overflow-x:hidden;

  text-rendering:optimizeLegibility;

  -webkit-font-smoothing:antialiased;

  -moz-osx-font-smoothing:grayscale;

}

.logo img,
.proposal-btn,
.desktop-nav a{

  will-change:transform;

}

@media (prefers-reduced-motion:reduce){

  *{

    animation:none !important;

    transition:none !important;

    scroll-behavior:auto !important;

  }

}

</style>
