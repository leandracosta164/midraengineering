---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<header class="site-header">

  <div class="header-backdrop"></div>

  <div class="container">

    <div class="header-inner">

      <a
        href="/"
        class="logo"
        aria-label="MIDRA Engineering Home"
      >

        <img
          src="/midra-icon.png"
          alt="MIDRA Engineering"
          width="140"
          height="140"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />

      </a>
            <nav
        class="desktop-nav"
        aria-label="Primary Navigation"
      >

        {
          navItems.map((item) => {

            const active =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);

            return (

              <a
                href={item.href}
                class={active ? "active" : ""}
                aria-current={active ? "page" : undefined}
              >

                {item.label}

              </a>

            );

          })
        }

      </nav>

      <a
        href="/contact"
        class="proposal-btn"
      >

        Request Proposal

      </a>

      <button
        id="mobileToggle"
        class="mobile-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>

</header>

<div
  id="mobileMenu"
  class="mobile-menu"
>

  <nav aria-label="Mobile Navigation">
      {
      navItems.map((item) => {

        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return (

          <a
            href={item.href}
            class={active ? "active" : ""}
            aria-current={active ? "page" : undefined}
          >

            {item.label}

          </a>

        );

      })
    }

    <a
      href="/contact"
      class="mobile-proposal"
    >

      Request Proposal

    </a>

  </nav>

</div>

<script>

const toggle = document.getElementById("mobileToggle");
const menu = document.getElementById("mobileMenu");

function closeMenu(){

  if(!toggle || !menu) return;

  menu.classList.remove("open");

  toggle.classList.remove("open");

  toggle.setAttribute("aria-expanded","false");

}

toggle?.addEventListener("click",()=>{

  if(!menu) return;

  const isOpen = menu.classList.toggle("open");

  toggle.classList.toggle("open",isOpen);

  toggle.setAttribute("aria-expanded",String(isOpen));

});

window.addEventListener("resize",()=>{

  if(window.innerWidth>900){

    closeMenu();

  }

});

document
  .querySelectorAll(".mobile-menu a")
  .forEach(link=>{

    link.addEventListener("click",closeMenu);

  });

window.addEventListener("scroll",()=>{

  const header=document.querySelector(".site-header");

  if(!header) return;

  if(window.scrollY>20){

    header.classList.add("scrolled");

  }else{

    header.classList.remove("scrolled");

  }

});

</script>

<style>

:root{

  --blue:#0E3A5D;
  --gold:#C6A15B;
  --light:#F8FAFC;
  --text:#24313F;
  --border:#E7ECF2;

}

.site-header{

  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:5000;

  background:rgba(255,255,255,.92);

  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);

  border-bottom:1px solid rgba(231,236,242,.80);

  transition:
    background .30s ease,
    box-shadow .30s ease,
    border-color .30s ease;

}

.site-header.scrolled{

  background:rgba(255,255,255,.97);

  box-shadow:
    0 14px 36px rgba(14,58,93,.08);

}

.header-backdrop{

  position:absolute;
  inset:0;
  pointer-events:none;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.30),
      transparent
    );

}
.container{

  width:min(1240px,92%);
  margin:0 auto;

}

.header-inner{

  height:94px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:28px;

}

.logo{

  display:flex;
  align-items:center;
  justify-content:flex-start;

  flex:0 0 auto;

  text-decoration:none;

  user-select:none;
  -webkit-user-drag:none;

}

.logo img{

  display:block;

  width:auto;

  height:126px;

  max-width:none;

  object-fit:contain;

  pointer-events:none;

  transition:
    transform .30s ease,
    filter .30s ease;

}

.logo:hover img{

  transform:scale(1.04);

}

.desktop-nav{

  display:flex;
  align-items:center;

  gap:36px;

  margin-left:auto;
  margin-right:34px;

}

.desktop-nav a{

  position:relative;

  display:inline-flex;
  align-items:center;

  height:94px;

  text-decoration:none;

  font-size:.96rem;
  font-weight:700;
  letter-spacing:.05em;

  color:var(--text);

  transition:
    color .25s ease;

}

.desktop-nav a::after{

  content:"";

  position:absolute;

  left:50%;
  bottom:18px;

  transform:translateX(-50%);

  width:0;

  height:2px;

  border-radius:999px;

  background:
    linear-gradient(
      90deg,
      var(--gold),
      #E4C887
    );

  transition:
    width .25s ease;

}

.desktop-nav a:hover{

  color:var(--blue);

}

.desktop-nav a:hover::after,
.desktop-nav a.active::after{

  width:100%;

}

.desktop-nav a.active{

  color:var(--blue);

}

.proposal-btn{

  display:inline-flex;

  align-items:center;
  justify-content:center;

  height:50px;

  padding:0 30px;

  border-radius:999px;

  background:
    linear-gradient(
      135deg,
      #0E3A5D,
      #184E7A
    );

  color:#fff;

  text-decoration:none;

  font-size:.94rem;
  font-weight:700;

  white-space:nowrap;

  box-shadow:
    0 12px 28px rgba(14,58,93,.16);

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}

.proposal-btn:hover{

  transform:translateY(-2px);

  box-shadow:
    0 18px 38px rgba(14,58,93,.22);

}

.proposal-btn:focus-visible,
.desktop-nav a:focus-visible,
.mobile-toggle:focus-visible{

  outline:2px solid var(--gold);

  outline-offset:4px;

  border-radius:8px;

}
.mobile-toggle{

  display:none;

  width:38px;
  height:30px;

  padding:0;

  border:none;
  background:none;

  cursor:pointer;

  position:relative;

}

.mobile-toggle span{

  position:absolute;

  left:0;

  width:100%;
  height:3px;

  border-radius:999px;

  background:var(--blue);

  transition:.30s;

}

.mobile-toggle span:nth-child(1){

  top:3px;

}

.mobile-toggle span:nth-child(2){

  top:13px;

}

.mobile-toggle span:nth-child(3){

  top:23px;

}

.mobile-toggle.open span:nth-child(1){

  top:13px;

  transform:rotate(45deg);

}

.mobile-toggle.open span:nth-child(2){

  opacity:0;

}

.mobile-toggle.open span:nth-child(3){

  top:13px;

  transform:rotate(-45deg);

}

.mobile-menu{

  position:fixed;

  top:94px;

  left:0;
  right:0;

  background:rgba(255,255,255,.98);

  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);

  border-bottom:1px solid var(--border);

  box-shadow:
    0 18px 42px rgba(0,0,0,.08);

  padding:30px 28px;

  transform:translateY(-120%);

  opacity:0;

  visibility:hidden;

  transition:
    transform .28s ease,
    opacity .28s ease,
    visibility .28s ease;

  z-index:4500;

}

.mobile-menu.open{

  transform:translateY(0);

  opacity:1;

  visibility:visible;

}

.mobile-menu nav{

  display:flex;

  flex-direction:column;

  align-items:center;

  gap:22px;

}

.mobile-menu a{

  text-decoration:none;

  font-size:1.04rem;

  font-weight:700;

  color:var(--text);

  transition:
    color .20s ease,
    transform .20s ease;

}

.mobile-menu a:hover,
.mobile-menu a.active{

  color:var(--gold);

  transform:translateY(-2px);

}

.mobile-proposal{

  margin-top:10px;

  display:inline-flex;

  align-items:center;
  justify-content:center;

  min-width:180px;

  height:48px;

  padding:0 30px;

  border-radius:999px;

  background:
    linear-gradient(
      135deg,
      #0E3A5D,
      #184E7A
    );

  color:#fff !important;

  text-decoration:none;

  font-weight:700;

  box-shadow:
    0 10px 28px rgba(14,58,93,.16);

  transition:
    transform .25s ease,
    box-shadow .25s ease;

}

.mobile-proposal:hover{

  transform:translateY(-2px);

  box-shadow:
    0 18px 38px rgba(14,58,93,.22);

}

.mobile-proposal:focus-visible,
.mobile-menu a:focus-visible{

  outline:2px solid var(--gold);

  outline-offset:4px;

  border-radius:8px;

}
@media (max-width:900px){

  .desktop-nav,
  .proposal-btn{

    display:none;

  }

  .mobile-toggle{

    display:block;

    margin-left:auto;

  }

  .header-inner{

    height:82px;

    gap:18px;

  }

  .logo{

    flex:0 0 auto;

  }

  .logo img{

    height:108px;

  }

  .mobile-menu{

    top:82px;

    padding:28px 22px;

  }

}

@media (max-width:600px){

  .container{

    width:min(94%,100%);

  }

  .header-inner{

    height:74px;

    gap:14px;

  }

  .logo img{

    height:84px;

  }

  .mobile-menu{

    top:74px;

    padding:24px 18px;

  }

  .mobile-menu nav{

    gap:18px;

  }

  .mobile-menu a{

    font-size:1rem;

  }

  .mobile-proposal{

    width:100%;
    max-width:250px;
    height:46px;

  }

}

.site-header,
.header-inner,
.logo,
.logo img{

  transform:translateZ(0);

  backface-visibility:hidden;

  -webkit-font-smoothing:antialiased;

}

.logo img,
img{

  image-rendering:auto;

  -webkit-user-drag:none;

  user-select:none;

}

html{

  scroll-behavior:smooth;

}

.site-header img{

  display:block;

}

.proposal-btn,
.mobile-proposal{

  min-width:170px;

}

.desktop-nav a,
.proposal-btn,
.mobile-proposal,
.logo img{

  will-change:transform;

}

body{

  overflow-x:hidden;

  text-rendering:optimizeLegibility;

  -webkit-font-smoothing:antialiased;

  -moz-osx-font-smoothing:grayscale;

}

@media (prefers-reduced-motion:reduce){

  *{

    animation:none !important;

    transition:none !important;

    scroll-behavior:auto !important;

  }

}

@media (min-width:1400px){

  .container{

    width:min(1320px,90%);

  }

  .desktop-nav{

    gap:42px;

  }

}

@media (max-width:420px){

  .header-inner{

    height:70px;

  }

  .logo img{

    height:72px;

  }

  .mobile-menu{

    top:70px;

    padding:22px 16px;

  }

  .mobile-proposal{

    max-width:220px;

    height:44px;

    font-size:.92rem;

  }

  .mobile-menu nav{

    gap:16px;

  }

}

</style>