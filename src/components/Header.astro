---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<header class="site-header">

  <div class="container">

    <div class="header-inner">

      <a
        href="/"
        class="logo"
        aria-label="MIDRA Engineering Home"
      >

        <img
          src="/Final_Midra_Logo_Transparent.png"
          alt="MIDRA Engineering"
          width="480"
          height="140"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />

      </a>

      <nav
        class="desktop-nav"
        aria-label="Primary Navigation"
      >

        {
          navItems.map((item) => {

            const active =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);

            return (

              <a
                href={item.href}
                class={active ? "active" : ""}
                aria-current={active ? "page" : undefined}
              >

                {item.label}

              </a>

            );

          })
        }

      </nav>

      <a
        href="/contact"
        class="proposal-btn"
      >

        Request Proposal

      </a>

      <button
        id="mobileToggle"
        class="mobile-toggle"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >

        <span></span>
        <span></span>
        <span></span>

      </button>

    </div>

  </div>

</header>

<div
  id="mobileMenu"
  class="mobile-menu"
>

  <nav aria-label="Mobile Navigation">

    {
      navItems.map((item) => {

        const active =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return (

          <a
            href={item.href}
            class={active ? "active" : ""}
            aria-current={active ? "page" : undefined}
          >

            {item.label}

          </a>

        );

      })
    }

    <a
      href="/contact"
      class="mobile-proposal"
    >

      Request Proposal

    </a>

  </nav>

</div>

<script>

const toggle = document.getElementById("mobileToggle");
const menu = document.getElementById("mobileMenu");

function closeMenu() {

  if (!toggle || !menu) return;

  menu.classList.remove("open");

  toggle.classList.remove("open");

  toggle.setAttribute("aria-expanded", "false");

}

toggle?.addEventListener("click", () => {

  if (!menu) return;

  const isOpen = menu.classList.toggle("open");

  toggle.classList.toggle("open", isOpen);

  toggle.setAttribute("aria-expanded", String(isOpen));

});

window.addEventListener("resize", () => {

  if (window.innerWidth > 900) {

    closeMenu();

  }

});

document
  .querySelectorAll(".mobile-menu a")
  .forEach(link => {

    link.addEventListener("click", closeMenu);

  });

</script>

<style>

:root{

--blue:#0E3A5D;
--gold:#C6A15B;
--light:#F8FAFC;
--text:#24313F;
--border:#E7ECF2;

}
.site-header{

position:fixed;

top:0;

left:0;

right:0;

z-index:5000;

background:#ffffff;

border-bottom:1px solid var(--border);

box-shadow:
0 8px 24px rgba(14,58,93,.05);

}

.container{

width:min(1240px,92%);

margin:0 auto;

}

.header-inner{

height:104px;

display:flex;

align-items:center;

justify-content:space-between;

gap:44px;

}

.logo{

display:flex;

align-items:center;

justify-content:flex-start;

flex:0 0 330px;

text-decoration:none;

user-select:none;

-webkit-user-drag:none;

}

.logo img{

display:block;

width:auto;

height:110px;

max-width:100%;

object-fit:contain;

user-select:none;

-webkit-user-drag:none;

pointer-events:none;

filter:none;

transition:none;

}

.desktop-nav{

display:flex;

align-items:center;

gap:42px;

margin-left:auto;

margin-right:28px;

}

.desktop-nav a{

position:relative;

display:inline-flex;

align-items:center;

height:104px;

text-decoration:none;

font-size:.96rem;

font-weight:700;

letter-spacing:.05em;

color:var(--text);

transition:

color .25s ease;

}

.desktop-nav a::after{

content:"";

position:absolute;

left:50%;

bottom:24px;

transform:translateX(-50%);

width:0;

height:2px;

border-radius:999px;

background:linear-gradient(

90deg,

var(--gold),

#E4C887

);

transition:width .25s ease;

}

.desktop-nav a:hover{

color:var(--blue);

}

.desktop-nav a:hover::after,

.desktop-nav a.active::after{

width:100%;

}

.desktop-nav a.active{

color:var(--blue);

}

.proposal-btn{

display:inline-flex;

align-items:center;

justify-content:center;

height:48px;

padding:0 28px;

border-radius:999px;

background:linear-gradient(

135deg,

#0E3A5D,

#184E7A

);

color:#fff;

text-decoration:none;

font-size:.94rem;

font-weight:700;

letter-spacing:.02em;

white-space:nowrap;

box-shadow:

0 10px 28px rgba(14,58,93,.16);

transition:

transform .20s ease,

box-shadow .20s ease,

background .20s ease;

}

.proposal-btn:hover{

transform:translateY(-2px);

box-shadow:

0 16px 34px rgba(14,58,93,.22);

}

.proposal-btn:focus-visible,

.desktop-nav a:focus-visible,

.mobile-toggle:focus-visible{

outline:2px solid var(--gold);

outline-offset:4px;

border-radius:8px;

}

.mobile-toggle{

display:none;

width:36px;

height:28px;

padding:0;

border:none;

background:none;

cursor:pointer;

position:relative;

}

.mobile-toggle span{

position:absolute;

left:0;

width:100%;

height:3px;

border-radius:999px;

background:var(--blue);

transition:.30s;

}

.mobile-toggle span:nth-child(1){

top:2px;

}

.mobile-toggle span:nth-child(2){

top:12px;

}

.mobile-toggle span:nth-child(3){

top:22px;

}

.mobile-toggle.open span:nth-child(1){

top:12px;

transform:rotate(45deg);

}

.mobile-toggle.open span:nth-child(2){

opacity:0;

}

.mobile-toggle.open span:nth-child(3){

top:12px;

transform:rotate(-45deg);

}

.mobile-menu{

position:fixed;

top:104px;

left:0;

right:0;

background:#ffffff;

border-bottom:1px solid var(--border);

box-shadow:

0 18px 42px rgba(0,0,0,.08);

padding:36px;

transform:translateY(-120%);

opacity:0;

visibility:hidden;

transition:

transform .25s ease,

opacity .25s ease,

visibility .25s ease;

z-index:4500;

}

.mobile-menu.open{

transform:translateY(0);

opacity:1;

visibility:visible;

}

.mobile-menu nav{

display:flex;

flex-direction:column;

align-items:center;

gap:24px;

}

.mobile-menu a{

text-decoration:none;

font-size:1.05rem;

font-weight:700;

color:var(--text);

transition:color .20s ease;

}

.mobile-menu a:hover,

.mobile-menu a.active{

color:var(--gold);

}

.mobile-proposal{

margin-top:12px;

display:inline-flex;

align-items:center;

justify-content:center;

height:48px;

padding:0 28px;

border-radius:999px;

background:linear-gradient(

135deg,

#0E3A5D,

#184E7A

);

color:#fff !important;

text-decoration:none;

font-weight:700;

box-shadow:

0 10px 28px rgba(14,58,93,.16);

}
@media (max-width:900px){

.desktop-nav,
.proposal-btn{

display:none;

}

.mobile-toggle{

display:block;

margin-left:auto;

}

.header-inner{

height:88px;

gap:20px;

}

.logo{

flex:0 0 auto;

}

.logo img{

height:72px;

}

.mobile-menu{

top:88px;

padding:32px 24px;

}

}

@media (max-width:600px){

.container{

width:min(94%,100%);

}

.header-inner{

height:80px;

gap:16px;

}

.logo img{

height:66px;

}

.mobile-menu{

top:80px;

padding:28px 20px;

}

.mobile-menu nav{

gap:20px;

}

.mobile-menu a{

font-size:1rem;

}

.mobile-proposal{

width:100%;

max-width:260px;

}

}

/* ---------- Improve rendering stability ---------- */

.site-header,
.header-inner,
.logo,
.logo img{

transform:translateZ(0);

backface-visibility:hidden;

-webkit-font-smoothing:antialiased;

}

/* Prevent image dragging */

img{

-webkit-user-drag:none;

}

/* Respect users who prefer reduced motion */

@media (prefers-reduced-motion:reduce){

*{

animation:none !important;

transition:none !important;

scroll-behavior:auto !important;

}

}

</style>