    title: "Technical Excellence",
    description:
      "Every project is designed with precision, practical engineering judgment, and strict attention to local, state, and NJDEP requirements."
  },
  {
    number: "02",
    title: "Responsive Communication",
    description:
      "We believe clients deserve timely updates, honest guidance, and direct communication throughout every stage of the project."
  },
  {
    number: "03",
    title: "Efficient Approvals",
    description:
      "Our permitting experience helps reduce unnecessary delays by preparing complete, coordinated engineering packages."
