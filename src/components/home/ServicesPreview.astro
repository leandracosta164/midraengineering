---
const services = [
  {
    title: "Residential Development",
    image: "/projects/residential-engineering.jpg",
    description:
      "Civil engineering services for custom homes, additions, grading, drainage, subdivisions, and permitting throughout New Jersey.",
    href: "/services"
  },
  {
    title: "Commercial Development",
    image: "/projects/commercial-development.jpg",
    description:
      "Comprehensive engineering for retail, industrial, office, and mixed-use developments from concept through municipal approval.",
    href: "/services"
  },
  {
    title: "Stormwater Management",
    image: "/projects/stormwater-management.jpg",
    description:
      "NJDEP-compliant stormwater management design including detention basins, infiltration systems, drainage analysis, and hydraulic calculations.",
    href: "/services"
  },
  {
    title: "Subdivision & Land Development",
    image: "/projects/subdivision-land-development.jpg",
    description:
      "Complete subdivision and land development engineering, including site layout, grading, utilities, and municipal approvals.",
    href: "/services"
  },
  {
    title: "Municipal Infrastructure",
    image: "/projects/municipal-infrastructure.jpg",
    description:
      "Engineering solutions for roadway improvements, public utilities, drainage systems, and municipal capital improvement projects.",
    href: "/services"
  },
  {
    title: "Construction Phase Services",
    image: "/projects/construction-phase-services.jpg",
    description:
      "Construction administration, field coordination, engineering revisions, inspections, and technical support throughout every phase of construction.",
    href: "/services"
  }
];
---

<section class="services-preview">

  <div class="container">

    <div class="section-heading">

      <span>

        OUR SERVICES

      </span>

      <h2>

        Engineering Solutions Built Around Your Project

      </h2>

      <p>

		MIDRA Engineering provides practical engineering
                solutions that balance technical excellence,
                regulatory compliance and constructability.

      </p>

    </div>

    <div class="services-grid">

      {

        services.map(service => (

          <article class="service-card">

            <div class="service-image">

              <img
                src={service.image}
                alt={service.title}
                loading="lazy"
              />

            </div>

            <div class="service-content">

              <h3>

                {service.title}

              </h3>

              <p>

                {service.description}

              </p>

              <a
                href={service.href}
                class="learn-more"
              >

                Explore Service

                <span>

                  →

                </span>

              </a>

            </div>

          </article>

        ))

      }

    </div>

    <div class="services-footer">

      <a
        href="/services"
        class="services-button"
      >

        Explore All Services

      </a>

    </div>

  </div>

</section>

<style>

.services-preview{

  padding:96px 0;

  background:#fff;

  position:relative;

  overflow:hidden;

}

.services-preview::before{

  content:"";

  position:absolute;

  width:700px;

  height:700px;

  border-radius:50%;

  background:

    radial-gradient(

      circle,

      rgba(198,161,91,.08),

      transparent 70%

    );

  right:-300px;

  top:-250px;

  pointer-events:none;

}

.section-heading{

  max-width:760px;

  margin:0 auto 60px;

  text-align:center;

  position:relative;

  z-index:2;

}

.section-heading span{

  display:inline-block;

  padding:9px 18px;

  background:#F8FAFC;

  border-radius:999px;

  color:#0E3A5D;

  font-size:.78rem;

  font-weight:700;

  letter-spacing:.14em;

  margin-bottom:22px;

}

.section-heading h2{

  font-size:clamp(2.5rem,5vw,3.6rem);

  line-height:1.15;

  color:#16324A;

  font-weight:800;

  margin-bottom:22px;

}

.section-heading p{

  font-size:1.08rem;

  line-height:1.85;

  color:#66707C;

}

.services-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:28px;

  position:relative;

  z-index:2;

}
.service-card{

  background:#fff;

  border-radius:24px;

  overflow:hidden;

  display:flex;

  flex-direction:column;

  border:1px solid rgba(0,0,0,.05);

  box-shadow:0 18px 45px rgba(0,0,0,.05);

  transition:.35s ease;

  height:100%;

}

.service-card:hover{

  transform:translateY(-10px);

  box-shadow:0 30px 70px rgba(14,58,93,.14);

  border-color:rgba(198,161,91,.28);

}

.service-image{

  position:relative;

  height:250px;

  overflow:hidden;

}

.service-image::after{

  content:"";

  position:absolute;

  inset:0;

  background:

    linear-gradient(

      180deg,

      rgba(14,58,93,.08),

      rgba(14,58,93,.18)

    );

  transition:.35s ease;

}

.service-card:hover .service-image::after{

  background:

    linear-gradient(

      180deg,

      rgba(14,58,93,.02),

      rgba(14,58,93,.12)

    );

}

.service-image img{

  width:100%;

  height:100%;

  object-fit:cover;

  display:block;

  transition:transform .7s ease;

}

.service-card:hover .service-image img{

  transform:scale(1.08);

}

.service-content{

  padding:30px;

  display:flex;

  flex-direction:column;

  flex:1;

}

.service-content h3{

  font-size:1.5rem;

  font-weight:800;

  line-height:1.3;

  color:#16324A;

  margin-bottom:16px;

  transition:.3s ease;

}

.service-card:hover h3{

  color:#C6A15B;

}

.service-content p{

  font-size:1rem;

  line-height:1.85;

  color:#66707C;

  margin-bottom:30px;

  flex:1;

}

.learn-more{

  display:inline-flex;

  align-items:center;

  gap:10px;

  font-weight:700;

  text-decoration:none;

  color:#0E3A5D;

  transition:.3s ease;

}

.learn-more span{

  font-size:1.15rem;

  transition:.3s ease;

}

.learn-more:hover{

  color:#C6A15B;

}

.learn-more:hover span{

  transform:translateX(8px);

}

.services-footer{

  display:flex;

  justify-content:center;

  margin-top:60px;

  position:relative;

  z-index:2;

}

.services-button{

  display:inline-flex;

  align-items:center;

  justify-content:center;

  padding:18px 38px;

  border-radius:999px;

  background:#0E3A5D;

  color:#fff;

  text-decoration:none;

  font-weight:700;

  letter-spacing:.02em;

  transition:.35s ease;

  box-shadow:0 18px 45px rgba(14,58,93,.18);

}

.services-button:hover{

  background:#174d79;

  transform:translateY(-4px);

  box-shadow:0 28px 60px rgba(14,58,93,.24);

}
@media (max-width:1100px){

  .services-grid{

    grid-template-columns:repeat(2,1fr);

    gap:26px;

  }

  .service-image{

    height:230px;

  }

}

@media (max-width:768px){

  .services-preview{

    padding:80px 0;

  }

  .section-heading{

    margin-bottom:48px;

  }

  .section-heading h2{

    font-size:2.3rem;

  }

  .section-heading p{

    font-size:1rem;

  }

  .services-grid{

    grid-template-columns:1fr;

    gap:24px;

  }

  .service-image{

    height:240px;

  }

  .service-content{

    padding:28px;

  }

  .service-content h3{

    font-size:1.4rem;

  }

  .services-footer{

    margin-top:48px;

  }

  .services-button{

    width:100%;

    max-width:340px;

  }

}

@media (max-width:480px){

  .services-preview{

    padding:72px 0;

  }

  .section-heading span{

    font-size:.68rem;

    padding:8px 14px;

  }

  .section-heading h2{

    font-size:2rem;

  }

  .service-image{

    height:220px;

  }

  .service-content{

    padding:24px;

  }

  .service-content h3{

    font-size:1.3rem;

  }

  .service-content p{

    font-size:.97rem;

    line-height:1.75;

  }

  .services-button{

    padding:17px 30px;

    font-size:.95rem;

  }

}

/* ---------- Rendering Improvements ---------- */

.services-preview,
.services-preview *{

  -webkit-font-smoothing:antialiased;

  -moz-osx-font-smoothing:grayscale;

}

.service-image img{

  image-rendering:auto;

  backface-visibility:hidden;

  transform:translateZ(0);

}

.service-card,
.services-button,
.learn-more{

  will-change:transform;

}

/* ---------- Reduced Motion ---------- */

@media (prefers-reduced-motion:reduce){

  .services-preview *{

    animation:none !important;

    transition:none !important;

    scroll-behavior:auto !important;

  }

}

</style>