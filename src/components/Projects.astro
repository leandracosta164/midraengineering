---
const projects = [
  {
    title: "Residential Site Development",
    category: "Residential",
    image: "/project-residential.png",
    description:
      "Complete civil engineering design for custom homes, grading, drainage, utility coordination, and permitting.",
    link: "/projects"
  },

  {
    title: "Commercial Engineering",
    category: "Commercial",
    image: "/project-commercial.png",
    description:
      "Comprehensive site engineering including stormwater management, utility design, and municipal approvals.",
    link: "/projects"
  },

  {
    title: "Stormwater Management",
    category: "Infrastructure",
    image: "/project-stormwater.png",
    description:
      "NJDEP-compliant stormwater analysis, detention basin design, hydraulic modeling, and drainage improvements.",
    link: "/projects"
  }
];
---

<section class="projects-section">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="projects-header">

      <span>

        FEATURED PROJECTS

      </span>

      <h2>

        Engineering
        Solutions Designed
        to Last.

      </h2>

      <p>

        Every successful project begins with thoughtful
        planning, sound engineering, and practical design.
        From residential developments to commercial sites
        and stormwater infrastructure, MIDRA Engineering
        delivers solutions built for long-term performance.

      </p>

    </div>

    <div class="projects-grid">

      {

        projects.map((project) => (

          <article class="project-card">

            <div class="project-image">

              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                decoding="async"
              />

              <div class="image-overlay"></div>

              <div class="project-category">

                {project.category}

              </div>

            </div>

            <div class="project-content">

              <h3>

                {project.title}

              </h3>

              <p>

                {project.description}

              </p>

              <a
                href={project.link}
                class="project-link"
              >

                View Project

                <span>

                  →

                </span>

              </a>

            </div>

          </article>

        ))

      }

    </div>

    <div class="projects-footer">

      <a
        href="/projects"
        class="projects-button"
      >

        View All Projects

        <span>

          →

        </span>

      </a>

    </div>

  </div>

</section>

<style>

.projects-section{

  position:relative;

  overflow:hidden;

  padding:140px 0;

  background:

    linear-gradient(

      180deg,

      #FFFFFF 0%,

      #F8FAFC 100%

    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(

      rgba(14,58,93,.05) 1px,

      transparent 1px

    ),

    linear-gradient(

      90deg,

      rgba(14,58,93,.05) 1px,

      transparent 1px

    );

  background-size:60px 60px;

  mask-image:

    linear-gradient(

      180deg,

      rgba(0,0,0,.95),

      transparent

    );

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-250px;

  bottom:-250px;

  width:700px;

  height:700px;

  border-radius:50%;

  background:

    radial-gradient(

      circle,

      rgba(198,161,91,.10),

      transparent 72%

    );

  pointer-events:none;

}

.projects-header{

  position:relative;

  z-index:2;

  max-width:760px;

  margin:0 auto 75px;

  text-align:center;

}

.projects-header span{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  background:#FFFFFF;

  border:1px solid rgba(14,58,93,.08);

  border-radius:999px;

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

  box-shadow:

    0 14px 35px rgba(0,0,0,.06);

}

.projects-header h2{

  margin:0 0 24px;

  font-size:clamp(2.8rem,5vw,4.2rem);

  line-height:1.06;

  font-weight:800;

  letter-spacing:-.03em;

  color:#16324A;

  text-wrap:balance;

}

.projects-header p{

  margin:0;

  font-size:1.08rem;

  line-height:1.95;

  color:#66707C;

}

.projects-grid{

  position:relative;

  z-index:2;

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:34px;

}
.project-card{

  position:relative;

  overflow:hidden;

  display:flex;

  flex-direction:column;

  height:100%;

  background:#FFFFFF;

  border-radius:28px;

  border:1px solid rgba(14,58,93,.06);

  box-shadow:

    0 22px 60px rgba(0,0,0,.06);

  transition:

    transform .35s ease,

    border-color .35s ease,

    box-shadow .35s ease;

}

.project-card::before{

  content:"";

  position:absolute;

  top:0;

  left:0;

  width:100%;

  height:4px;

  background:

    linear-gradient(

      90deg,

      #0E3A5D,

      #C6A15B

    );

  z-index:5;

}

.project-card:hover{

  transform:translateY(-10px);

  border-color:rgba(198,161,91,.28);

  box-shadow:

    0 35px 80px rgba(14,58,93,.12);

}

.project-image{

  position:relative;

  overflow:hidden;

  height:270px;

}

.project-image img{

  display:block;

  width:100%;

  height:100%;

  object-fit:cover;

  transition:transform .7s ease;

}

.project-card:hover img{

  transform:scale(1.08);

}

.image-overlay{

  position:absolute;

  inset:0;

  background:

    linear-gradient(

      180deg,

      transparent 35%,

      rgba(0,0,0,.28)

    );

}

.project-category{

  position:absolute;

  top:22px;

  left:22px;

  padding:10px 16px;

  border-radius:999px;

  background:rgba(255,255,255,.95);

  backdrop-filter:blur(8px);

  font-size:.72rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  box-shadow:

    0 14px 35px rgba(0,0,0,.08);

}

.project-content{

  display:flex;

  flex-direction:column;

  flex:1;

  padding:38px;

}

.project-content h3{

  margin:0 0 18px;

  font-size:1.55rem;

  font-weight:800;

  line-height:1.3;

  color:#16324A;

}

.project-content p{

  flex:1;

  margin:0 0 34px;

  line-height:1.9;

  color:#66707C;

}

.project-link{

  display:inline-flex;

  align-items:center;

  gap:12px;

  font-weight:700;

  text-decoration:none;

  color:#0E3A5D;

  transition:color .3s ease;

}

.project-link span{

  font-size:1.15rem;

  transition:transform .3s ease;

}

.project-link:hover{

  color:#C6A15B;

}

.project-link:hover span{

  transform:translateX(8px);

}

.projects-footer{

  position:relative;

  z-index:2;

  display:flex;

  justify-content:center;

  margin-top:70px;

}

.projects-button{

  display:inline-flex;

  align-items:center;

  justify-content:center;

  gap:10px;

  padding:20px 40px;

  border-radius:999px;

  background:#0E3A5D;

  color:#FFFFFF;

  text-decoration:none;

  font-weight:700;

  transition:

    transform .35s ease,

    background .35s ease,

    box-shadow .35s ease;

  box-shadow:

    0 22px 55px rgba(14,58,93,.18);

}

.projects-button:hover{

  background:#184E79;

  transform:translateY(-4px);

  box-shadow:

    0 30px 70px rgba(14,58,93,.24);

}

.projects-button span{

  transition:transform .3s ease;

}

.projects-button:hover span{

  transform:translateX(6px);

}
@media (max-width:1100px){

  .projects-section{

    padding:110px 0;

  }

  .projects-grid{

    grid-template-columns:repeat(2,1fr);

    gap:30px;

  }

}

@media (max-width:768px){

  .projects-section{

    padding:90px 0;

  }

  .projects-header{

    margin-bottom:55px;

  }

  .projects-header h2{

    font-size:2.5rem;

  }

  .projects-header p{

    font-size:1rem;

  }

  .projects-grid{

    grid-template-columns:1fr;

    gap:26px;

  }

  .project-image{

    height:240px;

  }

  .project-content{

    padding:32px;

  }

  .projects-footer{

    margin-top:55px;

  }

  .projects-button{

    width:100%;

    max-width:340px;

  }

}

@media (max-width:480px){

  .projects-section{

    padding:80px 0;

  }

  .projects-header span{

    font-size:.68rem;

    padding:8px 14px;

  }

  .projects-header h2{

    font-size:2rem;

  }

  .project-card{

    border-radius:22px;

  }

  .project-image{

    height:220px;

  }

  .project-content{

    padding:28px;

  }

  .project-content h3{

    font-size:1.35rem;

  }

  .projects-button{

    width:100%;

  }

}

/* ---------- Rendering Improvements ---------- */

.projects-section,
.projects-section *{

  -webkit-font-smoothing:antialiased;

  -moz-osx-font-smoothing:grayscale;

}

.project-image img{

  image-rendering:auto;

  backface-visibility:hidden;

  transform:translateZ(0);

}

.project-card,
.projects-button,
.project-link{

  will-change:transform;

}

/* ---------- Reduced Motion ---------- */

@media (prefers-reduced-motion:reduce){

  .projects-section *{

    animation:none !important;

    transition:none !important;

    scroll-behavior:auto !important;

  }

}

</style>
