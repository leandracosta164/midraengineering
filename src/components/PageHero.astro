---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const {
  title,
  subtitle = "",
  image = "/hero-subdivision.jpg"
} = Astro.props;
---

<section
  class="page-hero"
  style={`
    background-image:
      linear-gradient(
        rgba(11,35,56,.80),
        rgba(14,58,93,.72)
      ),
      url(${image});
  `}
>

  <div class="hero-overlay"></div>

  <div class="hero-grid"></div>

  <div class="hero-pattern">

    <span></span>

    <span></span>

    <span></span>

  </div>

  <div class="container">

    <div class="hero-content">

      <nav
        class="breadcrumb"
        aria-label="Breadcrumb"
      >

        <a href="/">

          Home

        </a>

        <span>

          /

        </span>

        <span aria-current="page">

          {title}

        </span>

      </nav>

      <h1>

        {title}

      </h1>

      <div class="hero-accent"></div>

      {

        subtitle && (

          <p>

            {subtitle}

          </p>

        )

      }

    </div>

  </div>

</section>

<style>

.page-hero{

  position:relative;

  display:flex;

  align-items:center;

  overflow:hidden;

  height:500px;

  padding-top:40px;

  background-size:cover;

  background-position:center 28%;

  background-repeat:no-repeat;

}

.hero-overlay{

  position:absolute;

  inset:0;

  background:

    linear-gradient(

      180deg,

      rgba(0,0,0,.08),

      rgba(0,0,0,.18)

    );

  pointer-events:none;

}

.hero-grid{

  position:absolute;

  inset:0;

  opacity:.08;

  background-image:

    linear-gradient(

      rgba(255,255,255,.14) 1px,

      transparent 1px

    ),

    linear-gradient(

      90deg,

      rgba(255,255,255,.14) 1px,

      transparent 1px

    );

  background-size:60px 60px;

  mask-image:

    linear-gradient(

      180deg,

      rgba(0,0,0,.95),

      transparent

    );

  pointer-events:none;

}

.hero-pattern{

  position:absolute;

  inset:0;

  overflow:hidden;

  pointer-events:none;

}

.hero-pattern span{

  position:absolute;

  border-radius:50%;

  animation:float 12s ease-in-out infinite;

  background:

    radial-gradient(

      circle,

      rgba(255,255,255,.08),

      transparent 72%

    );

}

.hero-pattern span:nth-child(1){

  width:520px;

  height:520px;

  top:-250px;

  right:-170px;

}

.hero-pattern span:nth-child(2){

  width:360px;

  height:360px;

  left:-120px;

  bottom:-130px;

  animation-delay:2s;

}

.hero-pattern span:nth-child(3){

  width:180px;

  height:180px;

  right:18%;

  bottom:22%;

  animation-delay:4s;

  background:

    radial-gradient(

      circle,

      rgba(198,161,91,.20),

      transparent 72%

    );

}

.hero-content{

  position:relative;

  z-index:2;

  max-width:760px;

  color:#FFFFFF;

  animation:fadeUp .7s ease;

}

.breadcrumb{

  display:flex;

  align-items:center;

  flex-wrap:wrap;

  gap:12px;

  margin-bottom:26px;

  font-size:.95rem;

  font-weight:600;

  color:rgba(255,255,255,.82);

}

.breadcrumb a{

  color:#FFFFFF;

  text-decoration:none;

  transition:color .3s ease;

}

.breadcrumb a:hover{

  color:#C6A15B;

}

.breadcrumb span:last-child{

  color:rgba(255,255,255,.72);

}

.hero-content h1{

  margin:0;

  font-size:clamp(3.2rem,5.8vw,5rem);

  line-height:1.04;

  font-weight:800;

  letter-spacing:-.03em;

  text-wrap:balance;

  max-width:900px;

  text-shadow:

    0 4px 18px rgba(0,0,0,.18);

}
.hero-accent{

  width:90px;

  height:5px;

  margin:24px 0 28px;

  border-radius:999px;

  background:

    linear-gradient(

      90deg,

      #C6A15B,

      #E2C98E

    );

  box-shadow:

    0 8px 20px rgba(198,161,91,.35);

}

.hero-content p{

  max-width:650px;

  margin:0;

  font-size:1.12rem;

  line-height:1.9;

  color:rgba(255,255,255,.90);

  text-shadow:

    0 2px 10px rgba(0,0,0,.16);

}

.page-hero::after{

  content:"";

  position:absolute;

  left:0;

  right:0;

  bottom:0;

  height:140px;

  background:

    linear-gradient(

      to bottom,

      transparent,

      rgba(255,255,255,.05)

    );

  pointer-events:none;

}

@keyframes fadeUp{

  from{

    opacity:0;

    transform:translateY(24px);

  }

  to{

    opacity:1;

    transform:translateY(0);

  }

}

@keyframes float{

  0%{

    transform:translateY(0) translateX(0);

  }

  50%{

    transform:translateY(-18px) translateX(10px);

  }

  100%{

    transform:translateY(0) translateX(0);

  }

}

@media (max-width:992px){

  .page-hero{

    height:440px;

    padding-top:30px;

    background-position:center;

  }

  .hero-content{

    max-width:680px;

  }

  .hero-content h1{

    font-size:clamp(2.8rem,6vw,4.2rem);

  }

  .hero-accent{

    width:75px;

    margin:22px 0 24px;

  }

  .hero-content p{

    font-size:1.05rem;

  }

}

@media (max-width:768px){

  .page-hero{

    height:380px;

    padding-top:24px;

    background-position:center;

  }

  .breadcrumb{

    gap:10px;

    margin-bottom:20px;

    font-size:.85rem;

  }

  .hero-content h1{

    font-size:2.45rem;

  }

  .hero-accent{

    width:65px;

    height:4px;

    margin:18px 0 20px;

  }

  .hero-content p{

    max-width:100%;

    font-size:1rem;

    line-height:1.8;

  }

}
