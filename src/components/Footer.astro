---
const services = [
  "Site Development",
  "Stormwater Management",
  "Grading Design",
  "Drainage Design",
  "Utility Design",
  "Construction Support"
];

const company = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<footer class="footer">

  <div class="container">

    <div class="footer-grid">

      <!-- =======================================================
           Brand
      ======================================================== -->

      <div class="footer-brand">

        <a
          href="/"
          class="footer-logo"
          aria-label="MIDRA Engineering"
        >

          <img
            src="/images/branding/midra-logo-white.png"
            alt="MIDRA Engineering"
            width="220"
            height="74"
            loading="lazy"
            decoding="async"
          />

        </a>

        <p class="footer-description">

          MIDRA Engineering provides professional civil engineering
          consulting services for residential, commercial,
          municipal and land development projects throughout New Jersey.

        </p>

      </div>

      <!-- =======================================================
           Company
      ======================================================== -->

      <div class="footer-column">

        <h3>

          Company

        </h3>

        <nav
          class="footer-nav"
          aria-label="Footer Navigation"
        >

          {
            company.map((item) => (

              <a href={item.href}>

                {item.label}

              </a>

            ))
          }

        </nav>

      </div>

      <!-- =======================================================
           Services
      ======================================================== -->

      <div class="footer-column">

        <h3>

          Services

        </h3>

        <ul class="footer-services">

          {
            services.map((service) => (

              <li>

                {service}

              </li>

            ))
          }

        </ul>

      </div>

      <!-- =======================================================
           Contact
      ======================================================== -->

      <div class="footer-column">

        <h3>

          Contact

        </h3>

        <div class="footer-contact">

          <div>

            <span>Email</span>

            <a href="mailto:info@midraengineering.com">

              info@midraengineering.com

            </a>

          </div>
      

          <div>

            <span>Phone</span>

            <a href="tel:+17325555555">

              (732) 555-5555

            </a>

            </div>
      

          <div>

            <span>OFFICE</span>

            <a href="New Jersey">

              New Jersey

            </a>

         <span>



</span>

<p>



</p>

          </div>

        </div>

        <a
          href="/contact"
          class="footer-button"
        >

          Request Proposal

        </a>

      </div>

  </div>
      <!-- =======================================================
         Footer Bottom
    ======================================================== -->

    <div class="footer-bottom">

      <div class="footer-bottom-left">

        <p>

          © {new Date().getFullYear()} MIDRA Engineering. All Rights Reserved.

        </p>

      </div>

      <div class="footer-bottom-center">

        <a href="/privacy-policy">

          Privacy Policy

        </a>

        <a href="/terms">

          Terms of Use

        </a>

      </div>

      <div class="footer-bottom-right">
      

        <!-- Instagram -->

        <a
          href="https://www.instagram.com/midraengineering"
          aria-label="Instagram"
          class="social-link"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >

            <path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5.2A4.8 4.8 0 1016.8 12 4.81 4.81 0 0012 7.2zm6.2-.9a1.15 1.15 0 11-1.15 1.15A1.15 1.15 0 0118.2 6.3zM12 9a3 3 0 103 3 3 3 0 00-3-3z"/>

          </svg>

        </a>

                <!-- Facebook -->

        <a
          href="https://www.facebook.com/midraengineering"
          aria-label="Facebook"
          class="social-link"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >

            <path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.25.2 2.25.2v2.47H15.2c-1.25 0-1.64.78-1.64 1.57V12h2.8l-.45 2.89h-2.35v6.99A10 10 0 0022 12z"/>

          </svg>

        </a>

                <!-- LinkedIn -->

        <a
          href="https://www.linkedin.com/company/midraengineering"
          aria-label="LinkedIn"
          class="social-link"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >

            <path d="M4.98 3.5C4.98 4.6 4.1 5.5 3 5.5S1 4.6 1 3.5 1.9 1.5 3 1.5s1.98.9 1.98 2zM1.5 8h3V22h-3V8zm7 0h2.88v1.91h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.59V22h-3v-7.04c0-1.68-.03-3.84-2.34-3.84-2.35 0-2.71 1.84-2.71 3.73V22h-3V8z"/>

          </svg>

        </a>

        <!-- X -->

        <a
          href="https://x.com/midraengineering"
          aria-label="X"
          class="social-link"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
          >

            <path d="M18.9 2H22l-6.9 7.9L23 22h-6.2l-4.8-6.3L6.5 22H3.4l7.3-8.3L1 2h6.3l4.4 5.9L18.9 2z"/>

          </svg>

        </a>

      </div>

    </div>

  </div>

</footer>

<style>
/* ==========================================================
   MIDRA Engineering Footer
   ========================================================== */

.footer {

  background: #08295E;

  color: #ffffff;

  margin-top: 80px;

}

.footer .container {

  max-width: 1280px;

  margin: 0 auto;

  padding: 0 24px;

}

/* ==========================================================
   Main Grid
   ========================================================== */

.footer-grid{

    display:grid;

    grid-template-columns:1.5fr .9fr .9fr .9fr;

    gap:60px;

    align-items:start;

}


/* ==========================================================
   Brand
   ========================================================== */

.footer-brand{

    max-width:500px;

}

.footer-logo{
    display:inline-flex;
    margin-bottom:6px;
}

.footer-logo img {

    display: block;

    width: 170px;
    height: auto;

}

/*
========================================================

NO LOGO ANIMATION

Do not add:

transform

scale

rotate

transition

The logo remains completely static.

========================================================
*/

.footer-description {

  color: rgba(255,255,255,.78);

  line-height: 1.8;

  font-size: 15px;

}

/* ==========================================================
   Columns
   ========================================================== */

.footer-column h3 {

  margin: 0 0 22px;

  font-family: "Playfair Display", serif;

  font-size: 24px;

  font-weight: 700;

  color: #ffffff;

}

.footer-nav {

  display: flex;

  flex-direction: column;

  gap: 14px;

}

.footer-nav a {

  color: rgba(255,255,255,.74);

  text-decoration: none;

  transition: color .2s ease;

}

.footer-nav a:hover {

  color: #C89B3C;

}

/* ==========================================================
   Services
   ========================================================== */

.footer-services {

  list-style: none;

  margin: 0;

  padding: 0;

}

.footer-services li {

  position: relative;

  padding-left: 18px;

  margin-bottom: 14px;

  color: rgba(255,255,255,.74);

}

.footer-services li::before {

  content: "";

  position: absolute;

  left: 0;

  top: 10px;

  width: 6px;

  height: 6px;

  border-radius: 50%;

  background: #C89B3C;

}

/* ==========================================================
   Contact
   ========================================================== */

.footer-contact {

  display: flex;

  flex-direction: column;

  gap: 20px;

  margin-bottom: 28px;

}

.footer-contact span {

  display: block;

  margin-bottom: 6px;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: .12em;

  text-transform: uppercase;

  color: #C89B3C;

}

.footer-contact a {

  color: #ffffff;

  text-decoration: none;

}

.footer-contact a:hover {

  color: #C89B3C;

}

.footer-contact p {

  margin: 0;

  color: rgba(255,255,255,.74);

}

/* ==========================================================
   CTA
   ========================================================== */

.footer-button {

    display: inline-flex;
    justify-content: center;
    align-items: center;

    height: 52px;
    padding: 0 30px;

    border-radius: 999px;

    background: #C89B3C;
    color: #08295E;

    text-decoration: none;
    font-weight: 700;

    transition:
        transform .35s ease,
        box-shadow .35s ease,
        background .35s ease,
        color .35s ease;

    box-shadow:
        0 12px 28px rgba(0,0,0,.18);

}

.footer-button:hover {

    background: #D5A846;

    transform: translateY(-4px);

    box-shadow:
        0 22px 48px rgba(0,0,0,.28);

}
/* ==========================================================
   Footer Bottom
   ========================================================== */

.footer-bottom {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 32px;

  padding: 28px 0;

  border-top: 1px solid rgba(255,255,255,.10);

}

.footer-bottom-left p {

  margin: 0;

  font-size: .92rem;

  color: rgba(255,255,255,.68);

}

.footer-bottom-center {

  display: flex;

  align-items: center;

  gap: 22px;

}

.footer-bottom-center a {

  color: rgba(255,255,255,.72);

  text-decoration: none;

  font-size: .92rem;

  transition: color .20s ease;

}

.footer-bottom-center a:hover {

  color: #C89B3C;

}

/* ==========================================================
   Social Icons
   ========================================================== */

.footer-bottom-right {

  display: flex;

  align-items: center;

  gap: 14px;

}

.social-link {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 42px;

  height: 42px;

  border-radius: 50%;

  color: rgba(255,255,255,.82);

  border: 1px solid rgba(255,255,255,.15);

  text-decoration: none;

  transition:
    background-color .20s ease,
    border-color .20s ease,
    color .20s ease;

}

.social-link svg {

  width: 18px;

  height: 18px;

}

.social-link:hover {

  background: #C89B3C;

  color: #08295E;

  border-color: #C89B3C;

}

/* ==========================================================
   Accessibility
   ========================================================== */

.footer a:focus-visible {

  outline: 3px solid #C89B3C;

  outline-offset: 4px;

  border-radius: 6px;

}

/* ==========================================================
   Responsive
   ========================================================== */

@media (max-width: 1100px) {

.footer-grid{
    display:grid;
    grid-template-columns:0.9fr 1fr 1fr;
    column-gap:45px;
}

  .footer-brand {

    grid-column: 1 / -1;

    max-width: 100%;

  }

}

@media (max-width: 768px) {

  .footer-grid {

    grid-template-columns: 1fr;

    gap: 40px;

    padding: 56px 0;

  }

  .footer-logo img {

    height: 92px;

  }

  .footer-bottom {

    flex-direction: column;

    text-align: center;

  }

  .footer-bottom-center {

    justify-content: center;

    flex-wrap: wrap;

  }

  .footer-bottom-right {

    justify-content: center;

  }

}

@media (max-width: 480px) {

  .footer .container {

    padding: 0 20px;

  }

  .footer-grid {

    gap: 32px;

  }

  .footer-column h3 {

    font-size: 1.3rem;

  }

  .footer-description {

    font-size: .95rem;

  }

  .footer-button {

    width: 100%;

  }

}

/* ==========================================================
   Reduced Motion
   ========================================================== */

@media (prefers-reduced-motion: reduce) {

  .footer *,
  .footer *::before,
  .footer *::after {

    animation: none !important;

    transition: none !important;

    scroll-behavior: auto !important;

  }

}
/* ==========================================================
   Rendering Improvements
   ========================================================== */

.footer,
.footer * {

  -webkit-font-smoothing: antialiased;

  -moz-osx-font-smoothing: grayscale;

  text-rendering: optimizeLegibility;

}

.footer img {

  display: block;

  max-width: 100%;

  height: auto;

  user-select: none;

  -webkit-user-drag: none;

}

.footer svg {

  display: block;

}

/* ==========================================================
   Selection
   ========================================================== */

.footer ::selection {

  background: #C89B3C;

  color: #08295E;

}

/* ==========================================================
   Print
   ========================================================== */

@media print {

  .footer {

    background: #ffffff !important;

    color: #000000 !important;

  }

  .footer-button,
  .footer-bottom-right {

    display: none;

  }

}

/* ==========================================================
   End
   ========================================================== */

</style>
