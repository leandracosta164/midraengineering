---
const services = [
  "Residential Engineering",
  "Commercial Development",
  "Stormwater Management",
  "Subdivision & Land Development",
  "Municipal Infrastructure",
  "Construction Phase Services"
];

const company = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Services", href: "/services" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" }
];
---

<footer class="footer">

<div class="background-grid"></div>
<div class="background-glow"></div>

<div class="footer-top">

<div class="container">

<div class="footer-grid">

<div class="footer-brand">

<a
href="/"
class="footer-logo"
aria-label="MIDRA Engineering Home"
>

<img
src="/Final_Midra_Logo_White.png"
alt="MIDRA Engineering"
/>

</a>

<p>

MIDRA Engineering delivers practical,
responsive civil engineering solutions
for residential, commercial and municipal
projects throughout New Jersey.

</p>

<div class="footer-badges">

<div>

Civil Engineering

</div>

<div>

Land Development

</div>

<div>

Stormwater Design

</div>

</div>

</div>

<div>

<h3>

Company

</h3>

<nav class="footer-links">

{
company.map(link => (

<a href={link.href}>

{link.label}

</a>

))
}

</nav>

</div>

<div>

<h3>

Services

</h3>

<ul class="footer-services">

{
services.map(service => (

<li>

{service}

</li>

))
}

</ul>

</div>

<div>

<h3>

Get In Touch

</h3>

<div class="footer-contact">

<div>

<span>

Email

</span>

<a href="mailto:info@midraengineering.com">

info@midraengineering.com

</a>

</div>

<div>

<span>

Phone

</span>

<a href="tel:+17325555555">

(732) 555-5555

</a>

</div>

<div>

<span>

Office

</span>

<p>

New Jersey

</p>

</div>

</div>

<a
href="/contact"
class="footer-button"
>

Request Proposal

</a>

</div>

</div>

</div>

</div>

<div class="footer-bottom">

<div class="container footer-bottom-inner">

<p>

© {new Date().getFullYear()} MIDRA Engineering.
All Rights Reserved.

</p>

<div class="footer-bottom-links">

<a href="/privacy-policy">

Privacy Policy

</a>

<a href="/terms">

Terms of Use

</a>

</div>

</div>

</div>

</footer>

<style>

.footer{

position:relative;

overflow:hidden;

background:

linear-gradient(
180deg,
#081b2b,
#0B2338
);

color:white;

}

.background-grid{

position:absolute;

inset:0;

opacity:.08;

background-image:

linear-gradient(
rgba(255,255,255,.08) 1px,
transparent 1px
),

linear-gradient(
90deg,
rgba(255,255,255,.08) 1px,
transparent 1px
);

background-size:56px 56px;

pointer-events:none;

}

.background-glow{

position:absolute;

right:-240px;

top:-240px;

width:620px;

height:620px;

border-radius:50%;

background:

radial-gradient(
circle,
rgba(198,161,91,.18),
transparent 72%
);

pointer-events:none;

}

.footer-top{

position:relative;

padding:72px 0 48px;

}

.footer-grid{

position:relative;

z-index:2;

display:grid;

grid-template-columns:

1.6fr 1fr 1fr 1.2fr;

gap:46px;

align-items:start;

}

.footer-logo{

display:inline-flex;

margin-bottom:18px;

text-decoration:none;

}

.footer-logo img{

height:158px;

width:auto;

display:block;

transition:

transform .35s ease,

filter .35s ease;

}
.footer-logo:hover img{

transform:scale(1.05);

filter:drop-shadow(0 10px 28px rgba(198,161,91,.24));

}

.footer-brand p{

max-width:370px;

margin:0 0 26px;

font-size:1rem;

line-height:1.85;

color:rgba(255,255,255,.76);

}

.footer-badges{

display:flex;

flex-wrap:wrap;

gap:10px;

}

.footer-badges div{

padding:9px 16px;

border-radius:999px;

background:rgba(255,255,255,.08);

border:1px solid rgba(255,255,255,.08);

backdrop-filter:blur(10px);

font-size:.78rem;

font-weight:700;

letter-spacing:.02em;

color:#fff;

transition:

background .30s ease,

border-color .30s ease,

transform .30s ease;

}

.footer-badges div:hover{

background:rgba(198,161,91,.16);

border-color:rgba(198,161,91,.34);

transform:translateY(-2px);

}

.footer h3{

margin:0 0 20px;

font-size:1.15rem;

font-weight:800;

letter-spacing:.02em;

color:#fff;

}

.footer-links{

display:flex;

flex-direction:column;

gap:14px;

}

.footer-links a{

color:rgba(255,255,255,.72);

text-decoration:none;

transition:

color .25s ease,

transform .25s ease;

}

.footer-links a:hover{

color:#C6A15B;

transform:translateX(5px);

}

.footer-services{

list-style:none;

padding:0;

margin:0;

display:flex;

flex-direction:column;

gap:14px;

}

.footer-services li{

position:relative;

padding-left:18px;

line-height:1.7;

color:rgba(255,255,255,.72);

}

.footer-services li::before{

content:"";

position:absolute;

left:0;

top:11px;

width:6px;

height:6px;

border-radius:50%;

background:#C6A15B;

}
.footer-contact{

display:flex;

flex-direction:column;

gap:22px;

margin-bottom:26px;

}

.footer-contact span{

display:block;

margin-bottom:7px;

font-size:.74rem;

font-weight:800;

letter-spacing:.12em;

text-transform:uppercase;

color:#C6A15B;

}

.footer-contact a{

color:#fff;

font-weight:600;

text-decoration:none;

transition:color .25s ease;

}

.footer-contact a:hover{

color:#C6A15B;

}

.footer-contact p{

margin:0;

line-height:1.7;

color:rgba(255,255,255,.72);

}

.footer-button{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 30px;

border-radius:999px;

background:#C6A15B;

color:#0B2338;

text-decoration:none;

font-weight:800;

transition:

transform .30s ease,

background .30s ease,

box-shadow .30s ease;

box-shadow:

0 16px 40px rgba(0,0,0,.24);

}

.footer-button:hover{

background:#D6B06A;

transform:translateY(-3px);

box-shadow:

0 22px 52px rgba(0,0,0,.28);

}

.footer-bottom{

border-top:1px solid rgba(255,255,255,.08);

padding:22px 0;

backdrop-filter:blur(8px);

}

.footer-bottom-inner{

display:flex;

justify-content:space-between;

align-items:center;

gap:24px;

}

.footer-bottom p{

margin:0;

font-size:.92rem;

letter-spacing:.02em;

color:rgba(255,255,255,.60);

}

.footer-bottom-links{

display:flex;

align-items:center;

gap:22px;

flex-wrap:wrap;

}

.footer-bottom-links a{

text-decoration:none;

font-size:.92rem;

font-weight:600;

color:rgba(255,255,255,.62);

transition:

color .25s ease,

transform .25s ease;

}

.footer-bottom-links a:hover{

color:#C6A15B;

transform:translateY(-1px);

}

.footer-bottom-links a:focus-visible,

.footer-links a:focus-visible,

.footer-button:focus-visible{

outline:2px solid #C6A15B;

outline-offset:4px;

border-radius:6px;

}
@media (max-width:1100px){

.footer-grid{

grid-template-columns:

repeat(2,1fr);

gap:40px;

}

.footer-brand{

grid-column:1/-1;

max-width:700px;

}

.footer-logo img{

height:140px;

}

}

@media (max-width:768px){

.footer-top{

padding:60px 0 40px;

}

.footer-grid{

grid-template-columns:1fr;

gap:34px;

}

.footer-brand{

max-width:100%;

}

.footer-logo{

margin-bottom:16px;

}

.footer-logo img{

height:108px;

}

.footer-brand p{

margin-bottom:22px;

}

.footer-contact{

margin-bottom:22px;

}

.footer-bottom-inner{

flex-direction:column;

text-align:center;

gap:16px;

}

.footer-bottom-links{

justify-content:center;

}

}

@media (max-width:480px){

.footer-top{

padding:52px 0 34px;

}

.footer-grid{

gap:28px;

}

.footer-logo img{

height:92px;

}

.footer-brand p{

font-size:.94rem;

line-height:1.75;

}

.footer-badges{

gap:8px;

}

.footer-badges div{

padding:8px 12px;

font-size:.70rem;

}

.footer h3{

margin-bottom:16px;

font-size:1.05rem;

}

.footer-links{

gap:12px;

}

.footer-services{

gap:12px;

}

.footer-contact{

gap:18px;

margin-bottom:20px;

}

.footer-button{

width:100%;

max-width:270px;

padding:14px 24px;

}

.footer-bottom{

padding:20px 0;

}

.footer-bottom p,

.footer-bottom-links a{

font-size:.85rem;

}

.footer-bottom-links{

gap:16px;

}

}

/* ---------- Rendering Improvements ---------- */

.footer,
.footer *{

-webkit-font-smoothing:antialiased;

-moz-osx-font-smoothing:grayscale;

}

.footer-logo img{

image-rendering:auto;

backface-visibility:hidden;

transform:translateZ(0);

}

.footer-button,
.footer-links a,
.footer-bottom-links a,
.footer-badges div{

will-change:transform;

}

/* ---------- Reduced Motion ---------- */

@media (prefers-reduced-motion:reduce){

.footer *{

animation:none !important;

transition:none !important;

scroll-behavior:auto !important;

}

}

</style>