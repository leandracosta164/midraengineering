---
const services = [
  {
    title: "Residential Engineering",
    description:
      "Complete engineering solutions for new homes, additions, subdivisions, grading, drainage and permitting throughout New Jersey.",
    href: "/services"
  },
  {
    title: "Commercial Development",
    description:
      "Site engineering for commercial, retail, industrial and mixed-use developments from concept through municipal approval.",
    href: "/services"
  },
  {
    title: "Stormwater Management",
    description:
      "NJDEP-compliant stormwater design including detention basins, infiltration systems, drainage analysis and hydraulic calculations.",
    href: "/services"
  },
  {
    title: "Site Planning",
    description:
      "Thoughtful site layouts that maximize functionality while satisfying zoning, environmental and engineering requirements.",
    href: "/services"
  },
  {
    title: "Permitting & Approvals",
    description:
      "Coordination with municipalities and regulatory agencies to streamline approvals and keep projects moving.",
    href: "/services"
  },
  {
    title: "Construction Support",
    description:
      "Engineering assistance throughout construction including revisions, field coordination and technical support.",
    href: "/services"
  }
];
---

<section class="services-preview">

<div class="container">

<div class="section-heading">

<span>

OUR SERVICES

</span>

<h2>

Engineering Services
Built Around Your Project

</h2>

<p>

Whether you're planning a custom home,
commercial development or municipal
improvement, MIDRA Engineering provides
responsive engineering solutions from
the first sketch through final approval.

</p>

</div>

<div class="services-grid">

{
services.map(service => (

<article class="service-card">

<div class="service-icon">

<svg
viewBox="0 0 24 24"
fill="none"
stroke="currentColor"
stroke-width="1.8"
stroke-linecap="round"
stroke-linejoin="round"
>

<path d="M5 12h14"/>

<path d="M12 5v14"/>

</svg>

</div>

<h3>

{service.title}

</h3>

<p>

{service.description}

</p>

<a
href={service.href}
class="learn-more"
>

Learn More

<span>

→

</span>

</a>

</article>

))
}

</div>

<div class="services-footer">

<a
href="/services"
class="services-button"
>

Explore All Services

</a>

</div>

</div>

</section>

<style>

.services-preview{

padding:120px 0;

background:white;

position:relative;

overflow:hidden;

}

.services-preview::before{

content:"";

position:absolute;

width:700px;

height:700px;

border-radius:50%;

background:

radial-gradient(
circle,
rgba(198,161,91,.08),
transparent 70%
);

right:-300px;

top:-250px;

pointer-events:none;

}

.section-heading{

max-width:760px;

margin:0 auto 70px;

text-align:center;

position:relative;

z-index:2;

}

.section-heading span{

display:inline-block;

padding:10px 18px;

background:#F8FAFC;

border-radius:999px;

color:#0E3A5D;

font-size:.78rem;

font-weight:700;

letter-spacing:.14em;

margin-bottom:26px;

}

.section-heading h2{

font-size:clamp(2.5rem,5vw,3.7rem);

line-height:1.15;

color:#16324A;

margin-bottom:24px;

font-weight:800;

}

.section-heading p{

font-size:1.08rem;

line-height:1.9;

color:#66707C;

}

.services-grid{

display:grid;

grid-template-columns:

repeat(3,1fr);

gap:34px;

position:relative;

z-index:2;

}

.service-card{

background:white;

border-radius:26px;

padding:42px;

border:1px solid rgba(0,0,0,.05);

box-shadow:

0 20px 55px rgba(0,0,0,.05);

transition:.4s ease;

display:flex;

flex-direction:column;

height:100%;

}

.service-card:hover{

transform:translateY(-10px);

box-shadow:

0 30px 70px rgba(14,58,93,.12);

border-color:rgba(198,161,91,.25);

}

.service-icon{

width:72px;

height:72px;

border-radius:20px;

background:

linear-gradient(
135deg,
#0E3A5D,
#1B5B8C
);

display:flex;

align-items:center;

justify-content:center;

margin-bottom:30px;

color:white;

}

.service-icon svg{

width:30px;

height:30px;

}
.service-card h3{

font-size:1.55rem;

font-weight:800;

line-height:1.3;

color:#16324A;

margin-bottom:18px;

}

.service-card p{

color:#66707C;

line-height:1.9;

font-size:1rem;

margin-bottom:34px;

flex:1;

}

.learn-more{

display:inline-flex;

align-items:center;

gap:12px;

text-decoration:none;

font-weight:700;

color:#0E3A5D;

transition:.3s;

}

.learn-more span{

transition:.3s;

font-size:1.15rem;

}

.learn-more:hover{

color:#C6A15B;

}

.learn-more:hover span{

transform:translateX(8px);

}

.services-footer{

display:flex;

justify-content:center;

margin-top:70px;

position:relative;

z-index:2;

}

.services-button{

display:inline-flex;

align-items:center;

justify-content:center;

padding:20px 38px;

border-radius:999px;

background:#0E3A5D;

color:white;

text-decoration:none;

font-weight:700;

letter-spacing:.02em;

transition:.35s;

box-shadow:

0 18px 45px rgba(14,58,93,.18);

}

.services-button:hover{

background:#174d79;

transform:translateY(-4px);

box-shadow:

0 28px 60px rgba(14,58,93,.24);

}

@media (max-width:1100px){

.services-grid{

grid-template-columns:

repeat(2,1fr);

}

}

@media (max-width:768px){

.services-preview{

padding:90px 0;

}

.section-heading{

margin-bottom:55px;

}

.section-heading h2{

font-size:2.4rem;

}

.section-heading p{

font-size:1rem;

}

.services-grid{

grid-template-columns:1fr;

gap:24px;

}

.service-card{

padding:34px;

}

.service-icon{

width:64px;

height:64px;

margin-bottom:24px;

}

.service-icon svg{

width:26px;

height:26px;

}

.services-footer{

margin-top:50px;

}

.services-button{

width:100%;

max-width:340px;

}

}

@media (max-width:480px){

.services-preview{

padding:80px 0;

}

.section-heading span{

font-size:.68rem;

padding:8px 14px;

}

.service-card{

padding:28px;

border-radius:22px;

}

.service-card h3{

font-size:1.35rem;

}

}

</style>