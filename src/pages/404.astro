---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="404 | Page Not Found | MIDRA Engineering"
  description="The page you're looking for could not be found."
>

<section class="error-page">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="error-card">

      <div class="error-number">

        404

      </div>

      <span class="error-tag">

        PAGE NOT FOUND

      </span>

      <h1>

        Oops! This Page
        Doesn't Exist.

      </h1>

      <p>

        The page you are looking for may have been moved,
        renamed, or is no longer available. Return to the
        homepage or contact our team and we'll be happy
        to help you find the information you need.

      </p>

      <div class="error-actions">

        <a
          href="/"
          class="primary-button"
        >

          Return Home

          <span>

            →

          </span>

        </a>

        <a
          href="/contact"
          class="secondary-button"
        >

          Contact Us

        </a>

      </div>

    </div>

  </div>

</section>

<style>
.error-page{

  position:relative;

  overflow:hidden;

  min-height:calc(100vh - 180px);

  display:flex;

  align-items:center;

  justify-content:center;

  padding:130px 0;

  background:

    linear-gradient(
      180deg,
      #F8FAFC,
      #FFFFFF
    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(
      rgba(14,58,93,.05) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(14,58,93,.05) 1px,
      transparent 1px
    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-220px;

  top:-180px;

  width:650px;

  height:650px;

  border-radius:50%;

  background:

    radial-gradient(
      circle,
      rgba(198,161,91,.10),
      transparent 72%
    );

  pointer-events:none;

}

.error-card{

  position:relative;

  z-index:2;

  max-width:760px;

  margin:0 auto;

  padding:70px;

  text-align:center;

  background:#FFFFFF;

  border-radius:32px;

  border:1px solid #EEF2F6;

  box-shadow:

    0 24px 70px rgba(15,58,93,.08);

}

.error-card::before{

  content:"";

  position:absolute;

  top:0;

  left:0;

  width:100%;

  height:5px;

  background:

    linear-gradient(
      90deg,
      #0E3A5D,
      #C6A15B
    );

}

.error-number{

  font-size:clamp(5rem,12vw,9rem);

  font-weight:800;

  line-height:1;

  letter-spacing:-.05em;

  color:#0E3A5D;

  margin-bottom:20px;

}

.error-tag{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  background:#F8FAFC;

  border:1px solid rgba(14,58,93,.08);

  border-radius:999px;

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:28px;

}

.error-card h1{

  margin:0 0 24px;

  font-size:clamp(2.6rem,5vw,4.2rem);

  line-height:1.06;

  font-weight:800;

  letter-spacing:-.03em;

  color:#16324A;

  text-wrap:balance;

}

.error-card p{

  max-width:560px;

  margin:0 auto 42px;

  font-size:1.08rem;

  line-height:1.95;

  color:#66707C;

}

.error-actions{

  display:flex;

  justify-content:center;

  align-items:center;

  gap:18px;

  flex-wrap:wrap;

}

.primary-button,

.secondary-button{

  display:inline-flex;

  align-items:center;

  justify-content:center;

  gap:10px;

  padding:18px 34px;

  border-radius:999px;

  text-decoration:none;

  font-weight:700;

  transition:
    transform .3s ease,
    background .3s ease,
    color .3s ease,
    box-shadow .3s ease;

}

.primary-button{

  background:#0E3A5D;

  color:#FFFFFF;

  box-shadow:

    0 16px 40px rgba(14,58,93,.18);

}

.primary-button:hover{

  background:#174D79;

  transform:translateY(-4px);

  box-shadow:

    0 24px 50px rgba(14,58,93,.22);

}

.primary-button span{

  transition:transform .3s ease;

}

.primary-button:hover span{

  transform:translateX(6px);

}

.secondary-button{

  background:#FFFFFF;

  color:#0E3A5D;

  border:2px solid #0E3A5D;

}

.secondary-button:hover{

  background:#0E3A5D;

  color:#FFFFFF;

  transform:translateY(-4px);

}
@media (max-width:768px){

  .error-page{

    padding:90px 0;

  }

  .error-card{

    padding:42px 28px;

    border-radius:26px;

  }

  .error-number{

    font-size:5rem;

  }

  .error-card h1{

    font-size:2.3rem;

  }

  .error-card p{

    font-size:1rem;

  }

  .error-actions{

    flex-direction:column;

  }

  .primary-button,

  .secondary-button{

    width:100%;

  }

}

@media (max-width:480px){

  .error-page{

    padding:80px 0;

  }

  .error-card{

    padding:30px 22px;

    border-radius:22px;

  }

  .error-number{

    font-size:4.2rem;

  }

  .error-tag{

    font-size:.68rem;

    padding:8px 14px;

  }

  .error-card h1{

    font-size:2rem;

  }

  .error-card p{

    font-size:.98rem;

    line-height:1.8;

  }

}

</style>

</Layout>