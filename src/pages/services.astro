---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const services = [
  {
    title: "Residential Engineering",
    icon: "🏡",
    description:
      "Professional civil engineering services for homeowners, builders, and developers throughout New Jersey.",

    features: [
      "Site Plans",
      "Grading & Drainage",
      "Septic Coordination",
      "Permit Drawings"
    ]
  },

  {
    title: "Commercial Development",
    icon: "🏢",
    description:
      "Complete engineering solutions for commercial, office, retail, industrial, and mixed-use developments.",

    features: [
      "Site Development",
      "Utility Design",
      "Parking Layout",
      "Permitting"
    ]
  },

  {
    title: "Stormwater Management",
    icon: "💧",
    description:
      "NJDEP-compliant stormwater management systems designed for performance and long-term reliability.",

    features: [
      "Detention Basins",
      "Infiltration Systems",
      "Hydraulic Modeling",
      "Drainage Reports"
    ]
  },

  {
    title: "Site Planning",
    icon: "📐",
    description:
      "Efficient site layouts that balance functionality, municipal requirements, and construction feasibility.",

    features: [
      "ADA Compliance",
      "Grading Plans",
      "Utility Coordination",
      "Site Layout"
    ]
  },

  {
    title: "Permitting",
    icon: "📄",
    description:
      "Preparation of engineering plans and supporting documentation for municipal, county, and state approvals.",

    features: [
      "Planning Boards",
      "County Agencies",
      "NJDEP Coordination",
      "Construction Documents"
    ]
  },

  {
    title: "Construction Support",
    icon: "🏗️",
    description:
      "Engineering assistance during construction to help projects stay compliant, efficient, and on schedule.",

    features: [
      "Field Support",
      "Plan Revisions",
      "Contractor Coordination",
      "Final Certifications"
    ]
  }
];
---
<Layout
  title="Civil Engineering Services | MIDRA Engineering"
  description="Professional civil engineering services throughout New Jersey for residential, commercial, municipal, and land development projects."
>

<PageHero
  title="Engineering Services"
  subtitle="Comprehensive Civil Engineering Solutions for Residential, Commercial, and Municipal Projects."
/>

<section class="services-page">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="services-intro">

      <span>

        WHAT WE DO

      </span>

      <h2>

        Engineering Solutions
        Designed Around
        Your Project

      </h2>

      <p>

        From concept through construction, MIDRA Engineering delivers
        practical civil engineering solutions focused on quality,
        efficiency, regulatory compliance, and long-term performance
        throughout New Jersey.

      </p>

    </div>

    <div class="services-grid">

      {

        services.map((service) => (

          <article class="service-card">

            <div class="service-icon">

              {service.icon}

            </div>

            <h3>

              {service.title}

            </h3>

            <p>

              {service.description}

            </p>

            <ul>

              {

                service.features.map((feature) => (

                  <li>

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >

                      <polyline points="20 6 9 17 4 12"></polyline>

                    </svg>

                    {feature}

                  </li>

                ))

              }

            </ul>

            <a
              href="/contact"
              class="service-button"
            >

              Discuss Your Project

              <span>

                →

              </span>

            </a>

          </article>

        ))

      }

    </div>

  </div>

</section>
<section class="process-section">

  <div class="container">

    <div class="section-heading">

      <span>

        OUR PROCESS

      </span>

      <h2>

        From Initial Consultation
        to Project Completion

      </h2>

      <p>

        Every project follows a structured engineering process that
        keeps communication clear, approvals moving, and construction
        on schedule.

      </p>

    </div>

    <div class="process-grid">

      <div class="process-card">

        <div class="process-number">

          01

        </div>

        <h3>

          Consultation

        </h3>

        <p>

          We discuss your project goals, property constraints,
          regulations, schedule, and engineering requirements.

        </p>

      </div>

      <div class="process-card">

        <div class="process-number">

          02

        </div>

        <h3>

          Site Evaluation

        </h3>

        <p>

          Existing conditions, utilities, grading, drainage,
          and permitting requirements are carefully evaluated.

        </p>

      </div>

      <div class="process-card">

        <div class="process-number">

          03

        </div>

        <h3>

          Engineering Design

        </h3>

        <p>

          Detailed engineering plans are prepared using practical,
          efficient, and code-compliant design solutions.

        </p>

      </div>

      <div class="process-card">

        <div class="process-number">

          04

        </div>

        <h3>

          Permitting

        </h3>

        <p>

          Plans and supporting documentation are coordinated with
          municipalities and regulatory agencies for approval.

        </p>

      </div>

      <div class="process-card">

        <div class="process-number">

          05

        </div>

        <h3>

          Construction Support

        </h3>

        <p>

          We remain involved throughout construction to answer
          questions and support successful project completion.

        </p>

      </div>

    </div>

  </div>

</section>

<CTA />

<style>

.services-page{

  position:relative;

  overflow:hidden;

  padding:130px 0;

  background:
    linear-gradient(
      180deg,
      #F8FAFC,
      #FFFFFF
    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(
      rgba(14,58,93,.05) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(14,58,93,.05) 1px,
      transparent 1px
    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  left:-250px;

  bottom:-250px;

  width:650px;

  height:650px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(198,161,91,.10),
      transparent 72%
    );

  pointer-events:none;

}

.services-intro{

  position:relative;

  z-index:2;

  max-width:760px;

  margin:0 auto 80px;

  text-align:center;

}

.services-intro span{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  border-radius:999px;

  background:#fff;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 15px 35px rgba(0,0,0,.05);

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

}

.services-intro h2{

  font-size:clamp(2.8rem,5vw,4.2rem);

  line-height:1.08;

  font-weight:800;

  color:#16324A;

  margin-bottom:28px;

}

.services-intro p{

  max-width:700px;

  margin:0 auto;

  font-size:1.08rem;

  line-height:1.9;

  color:#66707C;

}

.services-grid{

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:34px;

}
.service-card{

  position:relative;

  display:flex;

  flex-direction:column;

  padding:42px;

  border-radius:28px;

  background:#FFFFFF;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 20px 55px rgba(14,58,93,.08);

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;

}

.service-card::before{

  content:"";

  position:absolute;

  left:0;

  top:0;

  width:100%;

  height:5px;

  background:linear-gradient(
    90deg,
    #0E3A5D,
    #C6A15B
  );

}

.service-card:hover{

  transform:translateY(-10px);

  border-color:rgba(14,58,93,.14);

  box-shadow:0 34px 80px rgba(14,58,93,.16);

}

.service-icon{

  display:flex;

  align-items:center;

  justify-content:center;

  width:76px;

  height:76px;

  margin-bottom:28px;

  border-radius:22px;

  background:linear-gradient(
    135deg,
    #0E3A5D,
    #1B5B8C
  );

  color:#FFFFFF;

  font-size:2rem;

  box-shadow:0 20px 45px rgba(14,58,93,.22);

}

.service-card h3{

  font-size:1.75rem;

  line-height:1.25;

  font-weight:800;

  color:#16324A;

  margin-bottom:18px;

}

.service-card p{

  color:#66707C;

  line-height:1.9;

  margin-bottom:28px;

}

.service-card ul{

  list-style:none;

  display:grid;

  gap:16px;

  margin-bottom:36px;

}

.service-card li{

  display:flex;

  align-items:center;

  gap:12px;

  color:#16324A;

  font-weight:600;

}

.service-card li svg{

  width:18px;

  height:18px;

  flex-shrink:0;

  color:#C6A15B;

}

.service-button{

  margin-top:auto;

  display:inline-flex;

  align-items:center;

  gap:12px;

  font-weight:700;

  color:#0E3A5D;

  transition:gap .3s ease,color .3s ease;

}

.service-button span{

  transition:transform .3s ease;

}

.service-button:hover{

  color:#1B5B8C;

  gap:18px;

}

.service-button:hover span{

  transform:translateX(4px);

}

.process-section{

  padding:130px 0;

  background:#FFFFFF;

}

.section-heading{

  max-width:760px;

  margin:0 auto 80px;

  text-align:center;

}

.section-heading span{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  border-radius:999px;

  background:#F8FAFC;

  border:1px solid rgba(14,58,93,.08);

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

}

.section-heading h2{

  font-size:clamp(2.7rem,5vw,4rem);

  line-height:1.08;

  font-weight:800;

  color:#16324A;

  margin-bottom:24px;

}

.section-heading p{

  max-width:680px;

  margin:0 auto;

  color:#66707C;

  font-size:1.08rem;

  line-height:1.9;

}

.process-grid{

  display:grid;

  grid-template-columns:repeat(5,1fr);

  gap:24px;

}

.process-card{

  padding:34px 28px;

  background:#F8FAFC;

  border-radius:24px;

  border:1px solid rgba(14,58,93,.08);

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}

.process-card:hover{

  transform:translateY(-8px);

  box-shadow:0 22px 55px rgba(14,58,93,.12);

}

.process-number{

  width:58px;

  height:58px;

  display:flex;

  align-items:center;

  justify-content:center;

  margin-bottom:22px;

  border-radius:16px;

  background:linear-gradient(
    135deg,
    #0E3A5D,
    #1B5B8C
  );

  color:#FFFFFF;

  font-weight:800;

  font-size:1rem;

}

.process-card h3{

  margin-bottom:14px;

  font-size:1.35rem;

  font-weight:800;

  color:#16324A;

}

.process-card p{

  color:#66707C;

  line-height:1.8;

}
@media (max-width:1100px){

  .services-page{

    padding:110px 0;

  }

  .services-grid{

    grid-template-columns:repeat(2,1fr);

    gap:28px;

  }

  .process-grid{

    grid-template-columns:repeat(2,1fr);

  }

}

@media (max-width:768px){

  .services-page{

    padding:90px 0;

  }

  .process-section{

    padding:90px 0;

  }

  .services-intro{

    margin-bottom:60px;

  }

  .services-intro h2{

    font-size:2.5rem;

  }

  .services-intro p{

    font-size:1rem;

  }

  .services-grid{

    grid-template-columns:1fr;

    gap:24px;

  }

  .service-card{

    padding:34px;

  }

  .service-icon{

    width:68px;

    height:68px;

    font-size:1.8rem;

  }

  .section-heading{

    margin-bottom:60px;

  }

  .section-heading h2{

    font-size:2.5rem;

  }

  .section-heading p{

    font-size:1rem;

  }

  .process-grid{

    grid-template-columns:1fr;

    gap:22px;

  }

}

@media (max-width:480px){

  .services-page{

    padding:80px 0;

  }

  .process-section{

    padding:80px 0;

  }

  .services-intro span,

  .section-heading span{

    font-size:.68rem;

    padding:8px 14px;

  }

  .services-intro h2,

  .section-heading h2{

    font-size:2rem;

  }

  .service-card{

    padding:28px;

    border-radius:22px;

  }

  .service-card h3{

    font-size:1.45rem;

  }

  .service-icon{

    width:60px;

    height:60px;

    border-radius:18px;

    font-size:1.6rem;

  }

  .process-card{

    padding:28px 24px;

    border-radius:20px;

  }

  .process-number{

    width:52px;

    height:52px;

    font-size:.95rem;

  }

  .process-card h3{

    font-size:1.2rem;

  }

}

</style>

</Layout>
