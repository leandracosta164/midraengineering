---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/InnerPageHero.astro";
import CTA from "../components/CTA.astro";

const services = [
  {
    title: "Residential Engineering",
    description:
      "Professional civil engineering services supporting homeowners, builders and developers from planning through construction.",

    features: [
      "Site Plans",
      "Grading Design",
      "Drainage Design",
      "Permit Drawings"
    ]
  },

  {
    title: "Commercial Development",
    description:
      "Civil engineering solutions for commercial, office, retail, industrial and mixed-use developments.",

    features: [
      "Site Development",
      "Utility Design",
      "Parking Layout",
      "Permitting Assistance"
    ]
  },

  {
    title: "Stormwater Management",
    description:
      "Stormwater systems designed to satisfy regulatory requirements while supporting long-term site performance.",

    features: [
      "Stormwater Reports",
      "Detention Systems",
      "Drainage Analysis",
      "Hydraulic Calculations"
    ]
  },

  {
    title: "Site Planning",
    description:
      "Thoughtful site layouts balancing functionality, constructability and municipal requirements.",

    features: [
      "ADA Compliance",
      "Grading Plans",
      "Utility Coordination",
      "Site Layout"
    ]
  },

  {
    title: "Permitting Assistance",
    description:
      "Engineering plans and documentation prepared to support municipal, county and state approvals.",

    features: [
      "Planning Boards",
      "County Agencies",
      "NJDEP Coordination",
      "Construction Documents"
    ]
  },

  {
    title: "Construction Support",
    description:
      "Engineering support throughout construction to help projects remain coordinated, compliant and on schedule.",

    features: [
      "Field Support",
      "Plan Revisions",
      "Contractor Coordination",
      "Final Certifications"
    ]
  }
];
---

<Layout
    title="Civil Engineering Services | MIDRA Engineering"
    description="Professional civil engineering services for residential, commercial, municipal and land development projects."
>

<PageHero
    title="Engineering Services"
    subtitle="Practical Civil Engineering Solutions Designed to Support Successful Projects."
/>

<section class="services-page">

<div class="container">

<div class="services-intro">

<span>

WHAT WE DO

</span>

<h2>

Professional Civil
Engineering Services

</h2>

<p>

MIDRA Engineering provides practical civil engineering
solutions from planning and permitting through construction.
Every service is delivered with technical expertise,
responsive communication and attention to detail.

</p>

</div>

<div class="services-grid">

{

services.map((service) => (

<article class="service-card">
<div class="service-accent"></div>

<h3>

  {service.title}

</h3>

<p>

  {service.description}

</p>

<ul>

  {

    service.features.map((feature) => (

      <li>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >

          <polyline points="20 6 9 17 4 12"></polyline>

        </svg>

        {feature}

      </li>

    ))

  }

</ul>

<a
  href="/contact"
  class="service-button"
>

  Request Proposal

</a>

</article>

))

}

</div>

</div>

</section>

<section class="process-section">

<div class="container">

<div class="section-heading">

<span>

OUR PROCESS

</span>

<h2>

A Structured
Approach to Every
Engineering Project

</h2>

<p>

Every project follows a clear engineering process focused on
planning, coordination, technical quality and successful
project delivery.

</p>

</div>

<div class="process-grid">

<div class="process-card">

<div class="process-number">

01

</div>

<h3>

Project Consultation

</h3>

<p>

We begin by understanding your project objectives,
site conditions and engineering requirements.

</p>

</div>

<div class="process-card">

<div class="process-number">

02

</div>

<h3>

Site Evaluation

</h3>

<p>

Existing conditions, grading, drainage,
utilities and regulatory requirements are
carefully evaluated.

</p>

</div>

<div class="process-card">

<div class="process-number">

03

</div>

<h3>

Engineering Design

</h3>

<p>

Detailed engineering plans are prepared
using practical, efficient and code-compliant
design solutions.

</p>

</div>

<div class="process-card">

<div class="process-number">

04

</div>

<h3>

Permitting

</h3>

<p>

Engineering plans and documentation are
prepared for review and approval by the
appropriate agencies.

</p>

</div>

<div class="process-card">

<div class="process-number">

05

</div>

<h3>

Construction Support

</h3>

<p>

We remain available throughout construction
to assist with engineering questions and
project coordination.

</p>

</div>

</div>

</div>

</section>

<CTA />

<style>
.services-page{

    padding:120px 0;

    background:#FFFFFF;

}

.services-intro{

    max-width:760px;

    margin:0 auto 72px;

    text-align:center;

}

.services-intro span{

    display:inline-block;

    margin-bottom:20px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.services-intro h2{

    margin-bottom:24px;

    color:#08295E;

}

.services-intro p{

    max-width:700px;

    margin:0 auto;

    line-height:1.9;

}

.services-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:32px;

}

.service-card{

    display:flex;

    flex-direction:column;

    padding:38px;

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:20px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.service-card:hover{

    border-color:#C89B3C;

    box-shadow:0 12px 30px rgba(8,41,94,.08);

}

.service-accent{

    width:56px;

    height:4px;

    margin-bottom:24px;

    border-radius:999px;

    background:#C89B3C;

}

.service-card h3{

    margin-bottom:18px;

    color:#08295E;

}

.service-card p{

    margin-bottom:28px;

    line-height:1.8;

}

.service-card ul{

    display:grid;

    gap:14px;

    margin-bottom:32px;

    list-style:none;

}

.service-card li{

    display:flex;

    align-items:center;

    gap:12px;

    color:#374151;

}

.service-card li svg{

    width:18px;

    height:18px;

    flex-shrink:0;

    color:#C89B3C;

}

.service-button{

    margin-top:auto;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-height:48px;

    padding:0 24px;

    border-radius:999px;

    background:#08295E;

    color:#FFFFFF;

    font-weight:600;

    transition:

        background-color .25s ease,

        box-shadow .25s ease;

}

.service-button:hover{

    background:#103A7A;

    box-shadow:0 10px 24px rgba(8,41,94,.16);

}
.process-section{

    padding:120px 0;

    background:#F8FAFC;

}

.section-heading{

    max-width:760px;

    margin:0 auto 72px;

    text-align:center;

}

.section-heading span{

    display:inline-block;

    margin-bottom:20px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.section-heading h2{

    margin-bottom:24px;

    color:#08295E;

}

.section-heading p{

    max-width:680px;

    margin:0 auto;

    line-height:1.9;

}

.process-grid{

    display:grid;

    grid-template-columns:repeat(5,1fr);

    gap:24px;

}

.process-card{

    padding:32px 24px;

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:20px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.process-card:hover{

    border-color:#C89B3C;

    box-shadow:0 10px 24px rgba(8,41,94,.08);

}

.process-number{

    display:flex;

    align-items:center;

    justify-content:center;

    width:52px;

    height:52px;

    margin-bottom:20px;

    border-radius:14px;

    background:#08295E;

    color:#FFFFFF;

    font-weight:700;

    font-size:.95rem;

}

.process-card h3{

    margin-bottom:14px;

    color:#08295E;

    font-size:1.2rem;

}

.process-card p{

    margin:0;

    line-height:1.8;

}

@media (max-width:1100px){

    .services-grid{

        grid-template-columns:repeat(2,1fr);

    }

    .process-grid{

        grid-template-columns:repeat(2,1fr);

    }

}

@media (max-width:768px){

    .services-page,

    .process-section{

        padding:90px 0;

    }

    .services-grid,

    .process-grid{

        grid-template-columns:1fr;

    }

    .services-intro{

        margin-bottom:56px;

    }

    .section-heading{

        margin-bottom:56px;

    }

    .service-card{

        padding:32px;

    }

}

@media (max-width:480px){

    .services-page,

    .process-section{

        padding:72px 0;

    }

    .service-card{

        padding:28px;

        border-radius:18px;

    }

    .process-card{

        padding:28px 22px;

        border-radius:18px;

    }

}
</style>

</Layout>
