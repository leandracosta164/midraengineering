---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/InnerPageHero.astro";

const contactInfo = [

  {
    title: "Email",
    value: "info@midraengineering.com",
    href: "mailto:info@midraengineering.com"
  },

  {
    title: "Phone",
    value: "(732) 555-5555",
    href: "tel:+17325555555"
  },

  {
    title: "Office",
    value: "New Jersey",
    href: null
  }

];

const socialLinks = [

  {
    name: "Instagram",
    url: "https://instagram.com/midraengineering"
  },

  {
    name: "Facebook",
    url: "https://facebook.com/midraengineering"
  },

  {
    name: "LinkedIn",
    url: "https://linkedin.com/company/midraengineering"
  },

  {
    name: "X",
    url: "https://x.com/midraengineering"
  }

];
---

<Layout
  title="Contact MIDRA Engineering"
  description="Contact MIDRA Engineering to discuss residential, commercial, municipal, stormwater and land development engineering projects."
>

<PageHero
  title="Contact MIDRA Engineering"
  subtitle="We look forward to learning about your project and discussing practical engineering solutions."
/>

<section class="contact-page">

<div class="container">

<div class="contact-grid">

<div class="contact-content">

<span class="section-tag">

GET IN TOUCH

</span>

<h2>

Let's Discuss
Your Next
Project

</h2>

<p>

Whether you're planning a residential,
commercial, municipal or land development
project, MIDRA Engineering is ready to provide
practical engineering guidance from concept
through construction.

</p>

<div class="contact-cards">

{

contactInfo.map((item) => (

<div class="contact-card">

<div class="contact-accent"></div>

<div>

<h3>

{item.title}

</h3>

{

item.href ? (

<a href={item.href}>

{item.value}

</a>

) : (

<p>

{item.value}

</p>

)

}

</div>

</div>

))

}

<div class="contact-card">

<div class="contact-accent"></div>

<div>

<h3>

Connect With Us

</h3>

<div class="social-links">

{

socialLinks.map((social) => (

<a
href={social.url}
target="_blank"
rel="noopener noreferrer"
>

{social.name}

</a>

))

}

</div>

</div>

</div>

</div>

</div>

<div class="contact-form-card">
<h3>

Request a Proposal

</h3>

<p class="form-intro">

Tell us about your project and a member of our team
will contact you as soon as possible.

</p>

<form
  id="contact-form"
  action="https://formspree.io/f/mykrlepz"
  method="POST"
>

<input
  type="hidden"
  name="_subject"
  value="New MIDRA Engineering Website Inquiry"
/>

<input
  type="text"
  name="_gotcha"
  tabindex="-1"
  autocomplete="off"
  style="display:none"
/>

<div class="form-grid">

<input
  type="text"
  name="name"
  placeholder="Full Name"
  autocomplete="name"
  required
/>

<input
  type="email"
  name="email"
  placeholder="Email Address"
  autocomplete="email"
  required
/>

<input
  type="tel"
  name="phone"
  placeholder="Phone Number"
  autocomplete="tel"
/>

<input
  type="text"
  name="location"
  placeholder="Project Location"
  autocomplete="address-level2"
/>

<textarea
  name="message"
  rows="6"
  placeholder="Please describe your project..."
  required
></textarea>

<button
  id="submit-button"
  type="submit"
>

Request Proposal

</button>

<p
  id="form-success"
  class="form-message success"
  hidden
>

Thank you. Your message has been received.
A member of MIDRA Engineering will contact you soon.

</p>

<p
  id="form-error"
  class="form-message error"
  hidden
>

We were unable to send your message.
Please try again or contact us directly.

</p>

</div>

</form>

</div>

</div>

</div>

</section>

<script>

document.addEventListener("DOMContentLoaded", () => {

const form = document.getElementById("contact-form");
const submitButton = document.getElementById("submit-button");
const successMessage = document.getElementById("form-success");
const errorMessage = document.getElementById("form-error");

if (!form) return;

form.addEventListener("submit", async (event) => {

event.preventDefault();

successMessage.hidden = true;
errorMessage.hidden = true;

submitButton.disabled = true;
submitButton.textContent = "Sending...";

const formData = new FormData(form);

try {

const response = await fetch(form.action, {

method: "POST",

body: formData,

headers: {

Accept: "application/json"

}

});

if (response.ok) {

form.reset();

successMessage.hidden = false;

} else {

errorMessage.hidden = false;

}

} catch {

errorMessage.hidden = false;

}

submitButton.disabled = false;

submitButton.textContent = "Request Proposal";

});

});

</script>

<style>
.contact-page{

    padding:120px 0;

    background:#FFFFFF;

}

.contact-grid{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:64px;

    align-items:start;

}

.section-tag{

    display:inline-block;

    margin-bottom:20px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.contact-content h2{

    margin-bottom:24px;

    color:#08295E;

}

.contact-content > p{

    margin-bottom:40px;

    line-height:1.9;

}

.contact-cards{

    display:grid;

    gap:18px;

}

.contact-card{

    display:flex;

    gap:20px;

    align-items:flex-start;

    padding:28px;

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:18px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.contact-card:hover{

    border-color:#C89B3C;

    box-shadow:0 10px 24px rgba(8,41,94,.08);

}

.contact-accent{

    width:4px;

    min-width:4px;

    align-self:stretch;

    border-radius:999px;

    background:#C89B3C;

}

.contact-card h3{

    margin-bottom:10px;

    color:#08295E;

}

.contact-card a{

    color:#374151;

    text-decoration:none;

}

.contact-card a:hover{

    color:#08295E;

}

.contact-card p{

    margin:0;

}

.social-links{

    display:flex;

    flex-wrap:wrap;

    gap:10px;

    margin-top:10px;

}

.social-links a{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    padding:8px 14px;

    border:1px solid #E5E7EB;

    border-radius:999px;

    color:#08295E;

    font-size:.9rem;

    font-weight:600;

    transition:

        border-color .25s ease,

        background-color .25s ease,

        color .25s ease;

}

.social-links a:hover{

    background:#08295E;

    border-color:#08295E;

    color:#FFFFFF;

}

.contact-form-card{

    padding:40px;

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:20px;

    box-shadow:0 12px 30px rgba(8,41,94,.08);

}

.contact-form-card h3{

    margin-bottom:12px;

    color:#08295E;

}

.form-intro{

    margin-bottom:28px;

    line-height:1.8;

}

.form-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:18px;

}

.form-grid input,

.form-grid textarea{

    width:100%;

    padding:16px;

    border:1px solid #D1D5DB;

    border-radius:12px;

    background:#FFFFFF;

    font:inherit;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.form-grid textarea{

    grid-column:1/-1;

    resize:vertical;

    min-height:180px;

}

.form-grid input:focus,

.form-grid textarea:focus{

    outline:none;

    border-color:#08295E;

    box-shadow:0 0 0 3px rgba(8,41,94,.08);

}

.form-grid button{

    grid-column:1/-1;

    min-height:52px;

    border:none;

    border-radius:999px;

    background:#08295E;

    color:#FFFFFF;

    font-weight:600;

    transition:

        background-color .25s ease,

        box-shadow .25s ease;

}

.form-grid button:hover{

    background:#103A7A;

    box-shadow:0 10px 24px rgba(8,41,94,.16);

}

.form-grid button:disabled{

    opacity:.7;

    cursor:not-allowed;

}
.form-message{

    grid-column:1/-1;

    margin:0;

    padding:16px 18px;

    border-radius:12px;

    font-size:.95rem;

    line-height:1.7;

}

.success{

    background:#F0FDF4;

    border:1px solid #BBF7D0;

    color:#166534;

}

.error{

    background:#FEF2F2;

    border:1px solid #FECACA;

    color:#991B1B;

}

@media (max-width:1100px){

    .contact-grid{

        grid-template-columns:1fr;

        gap:56px;

    }

}

@media (max-width:768px){

    .contact-page{

        padding:90px 0;

    }

    .contact-form-card{

        padding:32px;

    }

    .form-grid{

        grid-template-columns:1fr;

    }

    .form-grid textarea,

    .form-grid button,

    .form-message{

        grid-column:auto;

    }

}

@media (max-width:480px){

    .contact-page{

        padding:72px 0;

    }

    .contact-card{

        padding:22px;

    }

    .contact-form-card{

        padding:24px;

        border-radius:18px;

    }

    .social-links{

        gap:8px;

    }

    .social-links a{

        width:100%;

        justify-content:center;

    }

    .form-grid input,

    .form-grid textarea{

        padding:14px;

    }

    .form-grid button{

        width:100%;

    }

}
</style>

</Layout>
