---
import Layout from "../layouts/Layout.astro";
import InnerPageHero from "../components/InnerPageHero.astro";
import CTA from "../components/CTA.astro";

const values = [
  {
    title: "Technical Excellence",
    text: "Every project is developed using sound engineering principles, attention to detail, and current industry standards."
  },

  {
    title: "Client-Focused Service",
    text: "Clear communication, responsiveness, and collaboration are central to every successful project."
  },

  {
    title: "Practical Engineering",
    text: "Our solutions are designed to be efficient, constructible, and aligned with regulatory requirements."
  },

  {
    title: "Integrity",
    text: "We approach every project with professionalism, accountability, and a commitment to long-term client relationships."
  }
];

const capabilities = [
  {
    title: "Residential",
    subtitle: "Engineering"
  },

  {
    title: "Commercial",
    subtitle: "Development"
  },

  {
    title: "Municipal",
    subtitle: "Infrastructure"
  },

  {
    title: "Land",
    subtitle: "Development"
  }
];
---

<Layout
  title="About MIDRA Engineering"
  description="Learn about MIDRA Engineering and our commitment to delivering practical civil engineering solutions for residential, commercial, municipal, and land development projects."
>

<InnerPageHero
  title="About MIDRA Engineering"
  subtitle="Professional Civil Engineering Solutions Built on Experience, Technical Excellence, and Client-Focused Service."
/>

<section class="about-story">

  <div class="container">

    <div class="about-grid">

      <div class="about-content">

        <span class="section-tag">

          WHO WE ARE

        </span>

        <h2>

          Engineering Expertise
          Built on Trust,
          Precision and Service.

        </h2>

        <p>

          MIDRA Engineering is a civil engineering consulting firm providing
          practical engineering solutions for residential, commercial,
          municipal and land development projects.

        </p>

        <p>

          We combine technical knowledge, responsive communication and
          practical design to help clients move confidently from planning
          through construction while meeting applicable regulatory
          requirements.

        </p>

        <p>

          Our approach emphasizes collaboration, attention to detail and
          dependable service, allowing owners, developers, architects,
          contractors and public agencies to move projects forward with
          confidence.

        </p>

        <div class="stats-grid">

          {

            capabilities.map((item) => (

              <div class="stat-card">

                <strong>

                  {item.title}

                </strong>

                <span>

                  {item.subtitle}

                </span>

              </div>

            ))

          }

        </div>

      </div>
            <div class="about-card">

        <div class="card-top">

          <h3>

            Our Mission

          </h3>

          <p>

            To provide practical, high-quality civil engineering solutions
            through technical excellence, responsive communication, and a
            commitment to helping every client achieve successful project
            outcomes.

          </p>

        </div>

        <div class="mission-list">

          <div>

            <strong>

              Technical Expertise

            </strong>

            <span>

              Engineering solutions developed with accuracy, efficiency,
              and attention to every project detail.

            </span>

          </div>

          <div>

            <strong>

              Responsive Communication

            </strong>

            <span>

              Keeping clients informed throughout planning, permitting,
              design and construction.

            </span>

          </div>

          <div>

            <strong>

              Commitment to Quality

            </strong>

            <span>

              Delivering dependable engineering solutions that support
              successful construction and long-term performance.

            </span>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<section class="values">

  <div class="container">

    <div class="section-header">

      <span>

        OUR VALUES

      </span>

      <h2>

        Principles That
        Guide Every
        Engineering Solution

      </h2>

      <p>

        Every project reflects our commitment to professionalism,
        technical excellence, practical engineering and long-term
        client relationships.

      </p>

    </div>

    <div class="values-grid">

      {

        values.map((value) => (

          <article class="value-card">

            <div class="value-accent"></div>

            <h3>

              {value.title}

            </h3>

            <p>

              {value.text}

            </p>

          </article>

        ))

      }

    </div>

  </div>

</section>

<CTA />

<style>
.about-story{

    padding:120px 0;

    background:#FFFFFF;

}

.about-grid{

    display:grid;

    grid-template-columns:1.2fr .8fr;

    gap:72px;

    align-items:start;

}

.about-content{

    max-width:720px;

}

.section-tag{

    display:inline-block;

    margin-bottom:22px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.about-content h2{

    margin-bottom:28px;

    color:#08295E;

}

.about-content p{

    margin-bottom:22px;

    font-size:1.05rem;

    line-height:1.9;

}

.stats-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:18px;

    margin-top:42px;

}

.stat-card{

    padding:28px;

    background:#F8FAFC;

    border:1px solid #E5E7EB;

    border-radius:18px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.stat-card:hover{

    border-color:#C89B3C;

    box-shadow:0 10px 28px rgba(8,41,94,.08);

}

.stat-card strong{

    display:block;

    margin-bottom:8px;

    font-size:1.3rem;

    color:#08295E;

}

.stat-card span{

    color:#6B7280;

    font-weight:500;

}

.about-card{

    padding:44px;

    background:#08295E;

    color:#FFFFFF;

    border-radius:24px;

    box-shadow:0 24px 60px rgba(8,41,94,.16);

}

.card-top{

    margin-bottom:36px;

}

.card-top h3{

    color:#FFFFFF;

    margin-bottom:18px;

}

.card-top p{

    color:rgba(255,255,255,.88);

    line-height:1.9;

}

.mission-list{

    display:flex;

    flex-direction:column;

    gap:28px;

}

.mission-list div{

    padding-top:24px;

    border-top:1px solid rgba(255,255,255,.18);

}

.mission-list div:first-child{

    border-top:none;

    padding-top:0;

}

.mission-list strong{

    display:block;

    margin-bottom:8px;

    color:#FFFFFF;

}

.mission-list span{

    color:rgba(255,255,255,.82);

    line-height:1.8;

}
.values{

    padding:120px 0;

    background:#F8FAFC;

}

.section-header{

    max-width:760px;

    margin:0 auto 72px;

    text-align:center;

}

.section-header span{

    display:inline-block;

    margin-bottom:20px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.section-header h2{

    margin-bottom:24px;

    color:#08295E;

}

.section-header p{

    max-width:680px;

    margin:0 auto;

    line-height:1.9;

}

.values-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:28px;

}

.value-card{

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:20px;

    padding:36px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.value-card:hover{

    border-color:#C89B3C;

    box-shadow:0 12px 30px rgba(8,41,94,.08);

}

.value-accent{

    width:56px;

    height:4px;

    border-radius:999px;

    background:#C89B3C;

    margin-bottom:24px;

}

.value-card h3{

    margin-bottom:18px;

    color:#08295E;

}

.value-card p{

    margin:0;

    line-height:1.8;

}

@media (max-width:1024px){

    .about-grid{

        grid-template-columns:1fr;

        gap:56px;

    }

    .about-card{

        max-width:760px;

    }

}

@media (max-width:768px){

    .about-story,

    .values{

        padding:90px 0;

    }

    .stats-grid,

    .values-grid{

        grid-template-columns:1fr;

    }

    .about-card{

        padding:36px;

    }

}

@media (max-width:480px){

    .about-story,

    .values{

        padding:72px 0;

    }

    .about-card{

        padding:28px;

        border-radius:20px;

    }

    .value-card{

        padding:28px;

    }

}
</style>

</Layout>

