---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const values = [
  {
    icon: "🎯",
    title: "Technical Excellence",
    text: "Every project is developed using proven engineering principles, attention to detail, and current industry standards."
  },

  {
    icon: "🤝",
    title: "Client Partnership",
    text: "Strong communication, transparency, and responsiveness are the foundation of every successful project."
  },

  {
    icon: "📐",
    title: "Practical Design",
    text: "Efficient engineering solutions designed to be buildable, cost-effective, and fully code compliant."
  },

  {
    icon: "✔️",
    title: "Integrity",
    text: "We approach every project with professionalism, accountability, honesty, and long-term commitment."
  }
];

const stats = [
  {
    number: "Residential",
    label: "Engineering"
  },

  {
    number: "Commercial",
    label: "Development"
  },

  {
    number: "Municipal",
    label: "Infrastructure"
  },

  {
    number: "Stormwater",
    label: "Management"
  }
];
---
<Layout
  title="About MIDRA Engineering"
  description="Learn about MIDRA Engineering and our commitment to delivering responsive civil engineering solutions throughout New Jersey."
>

<PageHero
  title="About MIDRA Engineering"
  subtitle="Professional Civil Engineering Solutions Built on Experience, Communication, and Practical Design."
/>

<section class="about-story">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="about-grid">

      <div class="about-content">

        <span class="section-tag">

          WHO WE ARE

        </span>

        <h2>

          Engineering
          Relationships Built
          on Trust.

        </h2>

        <p>

          MIDRA Engineering is a New Jersey civil engineering consulting
          firm providing practical engineering solutions for residential,
          commercial, municipal, and land development projects.

        </p>

        <p>

          Every project begins with understanding our client's goals.
          We combine technical expertise, responsive communication,
          and practical engineering to create solutions that are
          efficient, buildable, and fully compliant with applicable
          regulations.

        </p>

        <p>

          From planning and permitting through construction support,
          we work closely with owners, architects, surveyors,
          contractors, and municipal agencies to keep projects moving
          forward with confidence.

        </p>

        <div class="stats-grid">

          {

            stats.map((stat) => (

              <div class="stat-card">

                <strong>

                  {stat.number}

                </strong>

                <span>

                  {stat.label}

                </span>

              </div>

            ))

          }

        </div>

      </div>

      <div class="about-card">

        <div class="card-top">

          <h3>

            Our Mission

          </h3>

          <p>

            Deliver practical engineering solutions that combine
            technical excellence, responsive communication,
            and dependable client service.

          </p>

        </div>

        <div class="mission-list">

          <div>

            <strong>

              Practical Engineering

            </strong>

            <span>

              Efficient designs that perform in the field.

            </span>

          </div>

          <div>

            <strong>

              Responsive Communication

            </strong>

            <span>

              Keeping clients informed throughout every phase.

            </span>

          </div>

          <div>

            <strong>

              Dependable Delivery

            </strong>

            <span>

              Reliable engineering focused on schedules,
              quality, and successful project outcomes.

            </span>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>
<section class="values">

  <div class="container">

    <div class="section-header">

      <span>

        OUR VALUES

      </span>

      <h2>

        The Principles
        That Guide
        Every Project

      </h2>

      <p>

        Our work is built on professionalism, technical expertise,
        and a commitment to delivering practical engineering
        solutions for every client.

      </p>

    </div>

    <div class="values-grid">

      {

        values.map((value) => (

          <article class="value-card">

            <div class="value-icon">

              {value.icon}

            </div>

            <h3>

              {value.title}

            </h3>

            <p>

              {value.text}

            </p>

          </article>

        ))

      }

    </div>

  </div>

</section>

<CTA />

<style>

.about-story{

  position:relative;

  overflow:hidden;

  padding:130px 0;

  background:#FFFFFF;

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(
      rgba(14,58,93,.05) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(14,58,93,.05) 1px,
      transparent 1px
    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-240px;

  top:-220px;

  width:620px;

  height:620px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(198,161,91,.10),
      transparent 72%
    );

  pointer-events:none;

}

.about-grid{

  position:relative;

  z-index:2;

  display:grid;

  grid-template-columns:1.15fr .85fr;

  gap:80px;

  align-items:center;

}

.about-content{

  max-width:720px;

}

.section-tag{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  border-radius:999px;

  background:#FFFFFF;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 14px 35px rgba(0,0,0,.05);

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

}

.about-content h2{

  font-size:clamp(2.8rem,5vw,4.2rem);

  line-height:1.08;

  font-weight:800;

  color:#16324A;

  margin-bottom:28px;

}

.about-content p{

  margin-bottom:22px;

  font-size:1.08rem;

  line-height:1.95;

  color:#66707C;

}

.stats-grid{

  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:18px;

  margin-top:42px;

}

.stat-card{

  padding:28px;

  border-radius:22px;

  background:#F8FAFC;

  border:1px solid rgba(14,58,93,.08);

}

.stat-card strong{

  display:block;

  margin-bottom:8px;

  font-size:1.4rem;

  font-weight:800;

  color:#0E3A5D;

}

.stat-card span{

  color:#66707C;

  font-weight:600;

}

.about-card{

  position:relative;

  overflow:hidden;

  padding:44px;

  border-radius:30px;

  background:
    linear-gradient(
      135deg,
      #0E3A5D,
      #184F7C
    );

  color:#FFFFFF;

  box-shadow:0 35px 90px rgba(14,58,93,.18);

}

.about-card::before{

  content:"";

  position:absolute;

  top:-120px;

  right:-120px;

  width:280px;

  height:280px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.10),
      transparent 72%
    );

}

.card-top,
.mission-list{

  position:relative;

  z-index:2;

}

.card-top h3{

  margin-bottom:18px;

  font-size:2rem;

  font-weight:800;

}

.card-top p{

  margin-bottom:34px;

  line-height:1.9;

  color:rgba(255,255,255,.84);

}

.mission-list{

  display:grid;

  gap:26px;

}

.mission-list div{

  padding-top:24px;

  border-top:1px solid rgba(255,255,255,.16);

}

.mission-list div:first-child{

  border-top:none;

  padding-top:0;

}

.mission-list strong{

  display:block;

  margin-bottom:8px;

  font-size:1.15rem;

}

.mission-list span{

  line-height:1.8;

  color:rgba(255,255,255,.80);

}

.values{

  padding:130px 0;

  background:linear-gradient(
    180deg,
    #F8FAFC,
    #FFFFFF
  );

}

.section-header{

  max-width:760px;

  margin:0 auto 80px;

  text-align:center;

}

.section-header span{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  border-radius:999px;

  background:#FFFFFF;

  border:1px solid rgba(14,58,93,.08);

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

}

.section-header h2{

  font-size:clamp(2.7rem,5vw,4rem);

  line-height:1.08;

  font-weight:800;

  color:#16324A;

  margin-bottom:24px;

}

.section-header p{

  max-width:680px;

  margin:0 auto;

  color:#66707C;

  line-height:1.9;

}

.values-grid{

  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:30px;

}
.value-card{

  position:relative;

  overflow:hidden;

  padding:38px;

  background:#FFFFFF;

  border-radius:24px;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 18px 45px rgba(14,58,93,.06);

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;

}

.value-card::before{

  content:"";

  position:absolute;

  left:0;

  top:0;

  width:100%;

  height:5px;

  background:linear-gradient(
    90deg,
    #0E3A5D,
    #C6A15B
  );

}

.value-card:hover{

  transform:translateY(-10px);

  border-color:rgba(198,161,91,.30);

  box-shadow:0 34px 80px rgba(14,58,93,.14);

}

.value-icon{

  display:flex;

  align-items:center;

  justify-content:center;

  width:72px;

  height:72px;

  margin-bottom:24px;

  border-radius:20px;

  background:linear-gradient(
    135deg,
    #0E3A5D,
    #1B5B8C
  );

  color:#FFFFFF;

  font-size:2rem;

  box-shadow:0 18px 45px rgba(14,58,93,.22);

}

.value-card h3{

  margin-bottom:18px;

  font-size:1.45rem;

  font-weight:800;

  line-height:1.3;

  color:#16324A;

}

.value-card p{

  margin:0;

  line-height:1.9;

  color:#66707C;

}

@media (max-width:1100px){

  .about-grid{

    grid-template-columns:1fr;

    gap:60px;

  }

  .about-content{

    max-width:100%;

  }

  .about-card{

    max-width:760px;

    margin:0 auto;

  }

}

@media (max-width:768px){

  .about-story,

  .values{

    padding:90px 0;

  }

  .about-content h2,

  .section-header h2{

    font-size:2.5rem;

  }

  .about-content p,

  .section-header p{

    font-size:1rem;

  }

  .stats-grid{

    grid-template-columns:1fr;

  }

  .values-grid{

    grid-template-columns:1fr;

    gap:24px;

  }

  .about-card{

    padding:34px;

  }

  .value-card{

    padding:32px;

  }

}

@media (max-width:480px){

  .about-story,

  .values{

    padding:80px 0;

  }

  .section-tag,

  .section-header span{

    font-size:.68rem;

    padding:8px 14px;

  }

  .about-content h2,

  .section-header h2{

    font-size:2rem;

  }

  .about-card{

    padding:28px;

    border-radius:24px;

  }

  .card-top h3{

    font-size:1.7rem;

  }

  .stat-card{

    padding:22px;

  }

  .value-card{

    padding:28px;

    border-radius:20px;

  }

  .value-icon{

    width:60px;

    height:60px;

    border-radius:18px;

    font-size:1.7rem;

  }

  .value-card h3{

    font-size:1.3rem;

  }

}

</style>

</Layout>