---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Terms of Use | MIDRA Engineering"
  description="Terms governing the use of the MIDRA Engineering website."
>

<section class="terms-page">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="terms-card">

      <span class="section-tag">

        LEGAL

      </span>

      <h1>

        Terms of Use

      </h1>

      <p class="effective-date">

        <strong>Effective Date:</strong> July 26, 2026

      </p>

      <div class="terms-content">

        <h2>

          Acceptance of Terms

        </h2>

        <p>

          By accessing and using this website, you agree to comply with these
          Terms of Use and all applicable laws and regulations.

        </p>

        <h2>

          Website Content

        </h2>

        <p>

          The information provided on this website is for general informational
          purposes only and should not be considered engineering advice for any
          specific project.

        </p>

        <h2>

          Intellectual Property

        </h2>

        <p>

          All website content, including text, graphics, logos, images, and
          design, is the property of MIDRA Engineering unless otherwise stated.

        </p>

        <h2>

          Limitation of Liability

        </h2>

        <p>

          MIDRA Engineering shall not be liable for any damages arising from the
          use of this website or reliance on the information presented.

        </p>

        <h2>

          External Links

        </h2>

        <p>

          This website may contain links to third-party websites. MIDRA
          Engineering is not responsible for the content or privacy practices of
          those websites.

        </p>

        <h2>

          Changes

        </h2>

        <p>

          We reserve the right to modify these Terms of Use at any time without
          prior notice.

        </p>

        <h2>

          Contact

        </h2>

        <p>

          Questions regarding these Terms may be directed to

          <a href="mailto:info@midraengineering.com">

            info@midraengineering.com

          </a>

        </p>

      </div>

    </div>

  </div>

</section>

<style>
.terms-page{

  position:relative;

  overflow:hidden;

  padding:130px 0;

  background:

    linear-gradient(
      180deg,
      #F8FAFC,
      #FFFFFF
    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(
      rgba(14,58,93,.05) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(14,58,93,.05) 1px,
      transparent 1px
    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-220px;

  top:-180px;

  width:650px;

  height:650px;

  border-radius:50%;

  background:

    radial-gradient(
      circle,
      rgba(198,161,91,.10),
      transparent 72%
    );

  pointer-events:none;

}

.terms-card{

  position:relative;

  z-index:2;

  max-width:900px;

  margin:0 auto;

  padding:70px;

  background:#FFFFFF;

  border-radius:30px;

  border:1px solid #EEF2F6;

  box-shadow:

    0 24px 70px rgba(15,58,93,.08);

}

.terms-card::before{

  content:"";

  position:absolute;

  top:0;

  left:0;

  width:100%;

  height:5px;

  background:

    linear-gradient(
      90deg,
      #0E3A5D,
      #C6A15B
    );

}

.section-tag{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  margin-bottom:24px;

  border-radius:999px;

  background:#F8FAFC;

  border:1px solid rgba(14,58,93,.08);

  color:#0E3A5D;

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

}

.terms-card h1{

  margin:0 0 16px;

  font-size:clamp(
    2.6rem,
    5vw,
    4rem
  );

  font-weight:800;

  line-height:1.05;

  letter-spacing:-.03em;

  color:#16324A;

}

.effective-date{

  margin:0 0 45px;

  color:#66707C;

  font-size:1rem;

}

.terms-content h2{

  margin:40px 0 14px;

  font-size:1.55rem;

  font-weight:800;

  color:#16324A;

}

.terms-content h2:first-child{

  margin-top:0;

}

.terms-content p{

  margin:0 0 20px;

  font-size:1.05rem;

  line-height:1.9;

  color:#66707C;

}

.terms-content a{

  color:#0E3A5D;

  font-weight:600;

  text-decoration:none;

  transition:

    color .3s ease;

}

.terms-content a:hover{

  color:#C6A15B;

}
@media (max-width:768px){

  .terms-page{

    padding:90px 0;

  }

  .terms-card{

    padding:42px 30px;

    border-radius:24px;

  }

  .terms-card h1{

    font-size:2.5rem;

  }

  .terms-content h2{

    font-size:1.4rem;

    margin-top:32px;

  }

  .terms-content p{

    font-size:1rem;

  }

}

@media (max-width:480px){

  .terms-page{

    padding:80px 0;

  }

  .terms-card{

    padding:30px 22px;

    border-radius:22px;

  }

  .section-tag{

    font-size:.68rem;

    padding:8px 14px;

  }

  .terms-card h1{

    font-size:2rem;

  }

  .effective-date{

    font-size:.95rem;

    margin-bottom:36px;

  }

  .terms-content h2{

    font-size:1.25rem;

  }

  .terms-content p{

    font-size:.95rem;

    line-height:1.8;

  }

}

</style>

</Layout>