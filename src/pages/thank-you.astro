---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank You | MIDRA Engineering"
  description="Thank you for contacting MIDRA Engineering. Your message has been received."
>

<section class="thank-you">

  <div class="background-grid"></div>
  <div class="background-glow"></div>

  <div class="container">

    <div class="card">

      <div class="checkmark">
        ✓
      </div>

      <h1>

        Thank You!

      </h1>

      <p>

        Your message has been received successfully.

      </p>

      <p class="secondary">

        One of our engineers will review your inquiry and contact you as soon as possible.

      </p>

      <div class="buttons">

        <a
          href="/"
          class="primary"
        >
          Return Home
        </a>

        <a
          href="/services"
          class="secondary-button"
        >
          View Services
        </a>

      </div>

    </div>

  </div>

</section>

<style>

.thank-you{

position:relative;

overflow:hidden;

padding:140px 0;

background:

linear-gradient(
180deg,
#F8FAFC,
#FFFFFF
);

min-height:70vh;

display:flex;

align-items:center;

}

.background-grid{

position:absolute;

inset:0;

opacity:.18;

background-image:

linear-gradient(
rgba(14,58,93,.05) 1px,
transparent 1px
),

linear-gradient(
90deg,
rgba(14,58,93,.05) 1px,
transparent 1px
);

background-size:60px 60px;

pointer-events:none;

}

.background-glow{

position:absolute;

right:-220px;

top:-180px;

width:600px;

height:600px;

border-radius:50%;

background:

radial-gradient(
circle,
rgba(198,161,91,.10),
transparent 72%
);

pointer-events:none;

}

.card{

position:relative;

z-index:2;

max-width:720px;

margin:auto;

padding:60px;

background:white;

border-radius:28px;

border:1px solid #EEF2F6;

text-align:center;

box-shadow:

0 30px 80px rgba(15,58,93,.08);

}

.checkmark{

width:90px;

height:90px;

margin:0 auto 30px;

border-radius:50%;

display:flex;

align-items:center;

justify-content:center;

font-size:2.8rem;

font-weight:700;

background:#ECFDF3;

color:#166534;

border:2px solid #BBF7D0;

}

h1{

margin:0 0 20px;

font-size:clamp(2.5rem,5vw,4rem);

font-weight:800;

color:#16324A;

}

p{

margin:0;

font-size:1.15rem;

line-height:1.8;

color:#4B5563;

}

.secondary{

margin-top:20px;

color:#6B7280;

}

.buttons{

display:flex;

justify-content:center;

gap:20px;

margin-top:45px;

flex-wrap:wrap;

}

.primary,

.secondary-button{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 34px;

border-radius:999px;

text-decoration:none;

font-weight:700;

transition:

transform .3s ease,
box-shadow .3s ease,
background .3s ease;

}

.primary{

background:#0E3A5D;

color:white;

}

.primary:hover{

background:#174D79;

transform:translateY(-3px);

box-shadow:

0 18px 40px rgba(14,58,93,.20);

}

.secondary-button{

background:white;

color:#0E3A5D;

border:1px solid #DCE7F0;

}

.secondary-button:hover{

transform:translateY(-3px);

box-shadow:

0 18px 40px rgba(14,58,93,.10);

}

@media (max-width:768px){

.thank-you{

padding:100px 0;

}

.card{

padding:40px 28px;

}

.buttons{

flex-direction:column;

}

.primary,

.secondary-button{

width:100%;

}

}

</style>

</Layout>