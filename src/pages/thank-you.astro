---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank You | MIDRA Engineering"
  description="Thank you for contacting MIDRA Engineering. Your message has been received."
>

<section class="thank-you">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="card">

      <div class="checkmark">

        ✓

      </div>

      <span class="success-tag">

        MESSAGE SENT

      </span>

      <h1>

        Thank You!

      </h1>

      <p>

        Your message has been received successfully.

      </p>

      <p class="secondary">

        One of our engineers will review your inquiry and
        contact you as soon as possible. We appreciate
        the opportunity to discuss your project.

      </p>

      <div class="buttons">

        <a
          href="/"
          class="primary"
        >

          Return Home

          <span>

            →

          </span>

        </a>

        <a
          href="/services"
          class="secondary-button"
        >

          View Services

        </a>

      </div>

    </div>

  </div>

</section>

<style>

.thank-you{

  position:relative;

  overflow:hidden;

  min-height:70vh;

  display:flex;

  align-items:center;

  padding:140px 0;

  background:

    linear-gradient(

      180deg,

      #F8FAFC,

      #FFFFFF

    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(

      rgba(14,58,93,.05) 1px,

      transparent 1px

    ),

    linear-gradient(

      90deg,

      rgba(14,58,93,.05) 1px,

      transparent 1px

    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-220px;

  top:-180px;

  width:600px;

  height:600px;

  border-radius:50%;

  background:

    radial-gradient(

      circle,

      rgba(198,161,91,.10),

      transparent 72%

    );

  pointer-events:none;

}

.card{

  position:relative;

  z-index:2;

  max-width:720px;

  margin:auto;

  padding:60px;

  text-align:center;

  background:#FFFFFF;

  border-radius:28px;

  border:1px solid #EEF2F6;

  box-shadow:

    0 30px 80px rgba(15,58,93,.08);

}

.card::before{

  content:"";

  position:absolute;

  top:0;

  left:0;

  width:100%;

  height:5px;

  background:

    linear-gradient(

      90deg,

      #0E3A5D,

      #C6A15B

    );

}

.checkmark{

  display:flex;

  align-items:center;

  justify-content:center;

  width:90px;

  height:90px;

  margin:0 auto 28px;

  border-radius:50%;

  font-size:2.8rem;

  font-weight:700;

  background:#ECFDF3;

  color:#166534;

  border:2px solid #BBF7D0;

}

.success-tag{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  margin-bottom:26px;

  border-radius:999px;

  background:#F8FAFC;

  border:1px solid rgba(14,58,93,.08);

  color:#0E3A5D;

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

}

.card h1{

  margin:0 0 20px;

  font-size:clamp(2.5rem,5vw,4rem);

  font-weight:800;

  line-height:1.05;

  letter-spacing:-.03em;

  color:#16324A;

}

.card p{

  margin:0;

  font-size:1.1rem;

  line-height:1.9;

  color:#4B5563;

}

.secondary{

  margin-top:20px !important;

  color:#6B7280 !important;

}

.buttons{

  display:flex;

  justify-content:center;

  gap:20px;

  flex-wrap:wrap;

  margin-top:45px;

}

.primary,

.secondary-button{

  display:inline-flex;

  align-items:center;

  justify-content:center;

  gap:10px;

  padding:16px 34px;

  border-radius:999px;

  text-decoration:none;

  font-weight:700;

  transition:

    transform .3s ease,

    box-shadow .3s ease,

    background .3s ease,

    color .3s ease;

}

.primary{

  background:#0E3A5D;

  color:#FFFFFF;

}

.primary:hover{

  background:#174D79;

  transform:translateY(-3px);

  box-shadow:

    0 18px 40px rgba(14,58,93,.20);

}

.primary span{

  transition:transform .3s ease;

}

.primary:hover span{

  transform:translateX(6px);

}

.secondary-button{

  background:#FFFFFF;

  color:#0E3A5D;

  border:1px solid #DCE7F0;

}

.secondary-button:hover{

  transform:translateY(-3px);

  box-shadow:

    0 18px 40px rgba(14,58,93,.10);

}

@media (max-width:768px){

  .thank-you{

    padding:100px 0;

  }

  .card{

    padding:40px 28px;

    border-radius:24px;

  }

  .card h1{

    font-size:2.5rem;

  }

  .card p{

    font-size:1rem;

  }

  .buttons{

    flex-direction:column;

  }

  .primary,

  .secondary-button{

    width:100%;

  }

}

@media (max-width:480px){

  .thank-you{

    padding:80px 0;

  }

  .card{

    padding:30px 22px;

    border-radius:22px;

  }

  .checkmark{

    width:72px;

    height:72px;

    font-size:2.2rem;

    margin-bottom:22px;

  }

  .success-tag{

    font-size:.68rem;

    padding:8px 14px;

  }

  .card h1{

    font-size:2rem;

  }

  .card p{

    font-size:.95rem;

    line-height:1.8;

  }

}

/* ---------- Rendering Improvements ---------- */

.thank-you,
.thank-you *{

  -webkit-font-smoothing:antialiased;

  -moz-osx-font-smoothing:grayscale;

}

.card,
.primary,
.secondary-button{

  will-change:transform;

}

/* ---------- Reduced Motion ---------- */

@media (prefers-reduced-motion:reduce){

  .thank-you *{

    animation:none !important;

    transition:none !important;

    scroll-behavior:auto !important;

  }

}

</style>

</Layout>
