---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const projects = [
  {
    category: "Residential",
    title: "Custom Residential Site Development",
    location: "New Jersey",
    image: "/projects/project-residential.png",

    description:
      "Complete civil engineering services for custom homes from concept through construction.",

    features: [
      "Site Planning",
      "Grading & Drainage",
      "Stormwater Design",
      "Municipal Approvals"
    ]
  },

  {
    category: "Commercial",
    title: "Commercial Property Development",
    location: "New Jersey",
    image: "/projects/project-commercial.png",

    description:
      "Civil engineering solutions for retail, office, industrial, and mixed-use developments.",

    features: [
      "Utility Design",
      "Parking Layout",
      "Site Engineering",
      "Permitting"
    ]
  },

  {
    category: "Stormwater",
    title: "Stormwater Management Systems",
    location: "New Jersey",
    image: "/projects/project-stormwater.png",

    description:
      "NJDEP-compliant stormwater management systems designed for long-term performance.",

    features: [
      "Detention Basins",
      "Infiltration Systems",
      "Drainage Analysis",
      "Hydraulic Modeling"
    ]
  },

  {
    category: "Municipal",
    title: "Municipal Infrastructure",
    location: "New Jersey",
    image: "/projects/project-municipal.png",

    description:
      "Engineering support for roadway improvements, drainage upgrades, and public infrastructure.",

    features: [
      "Roadway Design",
      "Drainage Improvements",
      "Utility Coordination",
      "Construction Support"
    ]
  },

  {
    category: "Land Development",
    title: "Subdivision & Land Development",
    location: "New Jersey",
    image: "/projects/project-subdivision.png",

    description:
      "Planning and engineering services for residential and commercial land development.",

    features: [
      "Subdivision Design",
      "Site Layout",
      "Utility Planning",
      "Agency Approvals"
    ]
  },

  {
    category: "Construction",
    title: "Construction Phase Services",
    location: "New Jersey",
    image: "/projects/project-construction.png",

    description:
      "Engineering assistance throughout construction to keep projects moving successfully.",

    features: [
      "Field Support",
      "Plan Revisions",
      "Contractor Coordination",
      "Final Certifications"
    ]
  }
];
---
<Layout
  title="Engineering Projects | MIDRA Engineering"
  description="Explore the residential, commercial, municipal, and stormwater engineering projects completed by MIDRA Engineering throughout New Jersey."
>

<PageHero
  title="Our Projects"
  subtitle="Engineering Solutions That Transform Ideas Into Successful Projects."
/>

<section class="projects-page">

  <div class="background-grid"></div>

  <div class="background-glow"></div>

  <div class="container">

    <div class="projects-intro">

      <span>

        OUR EXPERIENCE

      </span>

      <h2>

        Engineering Projects
        Built for Long-Term
        Performance

      </h2>

      <p>

        From residential developments to municipal infrastructure,
        every project reflects our commitment to practical engineering,
        regulatory compliance, and lasting value.

      </p>

    </div>

    <div class="projects-grid">

      {

        projects.map((project) => (

          <article class="project-card">

            <div class="project-image">

              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
              />

              <div class="project-category">

                {project.category}

              </div>

            </div>

            <div class="project-content">

              <div class="project-location">

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >

                  <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0"/>

                  <circle
                    cx="12"
                    cy="10"
                    r="3"
                  />

                </svg>

                {project.location}

              </div>

              <h3>

                {project.title}

              </h3>

              <p>

                {project.description}

              </p>

              <ul>

                {

                  project.features.map((feature) => (

                    <li>

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >

                        <polyline points="20 6 9 17 4 12"></polyline>

                      </svg>

                      {feature}

                    </li>

                  ))

                }

              </ul>

              <a
                href="/contact"
                class="project-link"
              >

                Discuss a Similar Project

                <span>

                  →

                </span>

              </a>

            </div>

          </article>

        ))

      }

    </div>

  </div>

</section>
<CTA />

<style>

.projects-page{

  position:relative;

  overflow:hidden;

  padding:130px 0;

  background:
    linear-gradient(
      180deg,
      #F8FAFC,
      #FFFFFF
    );

}

.background-grid{

  position:absolute;

  inset:0;

  opacity:.18;

  background-image:

    linear-gradient(
      rgba(14,58,93,.05) 1px,
      transparent 1px
    ),

    linear-gradient(
      90deg,
      rgba(14,58,93,.05) 1px,
      transparent 1px
    );

  background-size:60px 60px;

  pointer-events:none;

}

.background-glow{

  position:absolute;

  right:-260px;

  top:-220px;

  width:650px;

  height:650px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      rgba(198,161,91,.10),
      transparent 72%
    );

  pointer-events:none;

}

.projects-intro{

  position:relative;

  z-index:2;

  max-width:760px;

  margin:0 auto 80px;

  text-align:center;

}

.projects-intro span{

  display:inline-flex;

  align-items:center;

  padding:10px 18px;

  border-radius:999px;

  background:#FFFFFF;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 15px 35px rgba(0,0,0,.05);

  font-size:.78rem;

  font-weight:800;

  letter-spacing:.14em;

  text-transform:uppercase;

  color:#0E3A5D;

  margin-bottom:24px;

}

.projects-intro h2{

  font-size:clamp(2.8rem,5vw,4.2rem);

  line-height:1.08;

  font-weight:800;

  color:#16324A;

  margin-bottom:28px;

}

.projects-intro p{

  max-width:700px;

  margin:0 auto;

  font-size:1.08rem;

  line-height:1.9;

  color:#66707C;

}

.projects-grid{

  position:relative;

  z-index:2;

  display:grid;

  grid-template-columns:repeat(2,1fr);

  gap:36px;

}

.project-card{

  display:flex;

  flex-direction:column;

  overflow:hidden;

  background:#FFFFFF;

  border-radius:28px;

  border:1px solid rgba(14,58,93,.08);

  box-shadow:0 20px 55px rgba(14,58,93,.08);

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;

}

.project-card:hover{

  transform:translateY(-10px);

  border-color:rgba(198,161,91,.30);

  box-shadow:0 34px 80px rgba(14,58,93,.16);

}

.project-image{

  position:relative;

  height:270px;

  overflow:hidden;

}

.project-image img{

  width:100%;

  height:100%;

  object-fit:cover;

  transition:transform .5s ease;

}

.project-card:hover .project-image img{

  transform:scale(1.06);

}

.project-category{

  position:absolute;

  top:22px;

  left:22px;

  padding:10px 18px;

  border-radius:999px;

  background:rgba(14,58,93,.92);

  color:#FFFFFF;

  font-size:.75rem;

  font-weight:800;

  letter-spacing:.08em;

  text-transform:uppercase;

  backdrop-filter:blur(10px);

}

.project-content{

  display:flex;

  flex-direction:column;

  flex:1;

  padding:36px;

}

.project-location{

  display:flex;

  align-items:center;

  gap:10px;

  margin-bottom:18px;

  color:#C6A15B;

  font-weight:700;

  font-size:.9rem;

}

.project-location svg{

  width:18px;

  height:18px;

}

.project-content h3{

  font-size:1.6rem;

  font-weight:800;

  line-height:1.3;

  color:#16324A;

  margin-bottom:18px;

}

.project-content p{

  margin-bottom:28px;

  color:#66707C;

  line-height:1.9;

}

.project-content ul{

  list-style:none;

  display:grid;

  gap:14px;

  margin-bottom:34px;

}

.project-content li{

  display:flex;

  align-items:center;

  gap:12px;

  color:#16324A;

  font-weight:600;

}

.project-content li svg{

  width:18px;

  height:18px;

  color:#C6A15B;

  flex-shrink:0;

}

.project-link{

  margin-top:auto;

  display:inline-flex;

  align-items:center;

  gap:10px;

  font-weight:700;

  color:#0E3A5D;

  transition:
    gap .3s ease,
    color .3s ease;

}

.project-link span{

  transition:transform .3s ease;

}

.project-link:hover{

  gap:16px;

  color:#C6A15B;

}

.project-link:hover span{

  transform:translateX(6px);

}
@media (max-width:1100px){

  .projects-page{

    padding:110px 0;

  }

  .projects-grid{

    grid-template-columns:1fr;

    gap:30px;

  }

}

@media (max-width:768px){

  .projects-page{

    padding:90px 0;

  }

  .projects-intro{

    margin-bottom:60px;

  }

  .projects-intro h2{

    font-size:2.5rem;

  }

  .projects-intro p{

    font-size:1rem;

  }

  .project-image{

    height:230px;

  }

  .project-content{

    padding:30px;

  }

  .project-content h3{

    font-size:1.45rem;

  }

}

@media (max-width:480px){

  .projects-page{

    padding:80px 0;

  }

  .projects-intro span{

    font-size:.68rem;

    padding:8px 14px;

  }

  .projects-intro h2{

    font-size:2rem;

  }

  .project-image{

    height:200px;

  }

  .project-content{

    padding:24px;

  }

  .project-content h3{

    font-size:1.3rem;

  }

  .project-location{

    font-size:.85rem;

  }

  .project-content ul{

    gap:12px;

  }

}

</style>

</Layout>