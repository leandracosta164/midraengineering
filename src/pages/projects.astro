---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/InnerPageHero.astro";
import CTA from "../components/CTA.astro";

const projects = [
  {
    category: "Residential",
    title: "Custom Residential Site Development",
    location: "New Jersey",
    image: "/images/projects/residential-subdivision.jpg",

    description:
      "Civil engineering services supporting residential developments from planning and permitting through construction.",

    features: [
      "Site Planning",
      "Grading Design",
      "Stormwater Management",
      "Municipal Approvals"
    ]
  },

  {
    category: "Commercial",
    title: "Commercial Property Development",
    location: "New Jersey",
    image: "/images/projects/commercial-site.jpg",

    description:
      "Engineering services for commercial, office, industrial and mixed-use developments.",

    features: [
      "Utility Design",
      "Parking Layout",
      "Site Engineering",
      "Permitting Assistance"
    ]
  },

  {
    category: "Stormwater",
    title: "Stormwater Management Systems",
    location: "New Jersey",
    image: "/images/projects/stormwater.jpg",

    description:
      "Stormwater management solutions designed for regulatory compliance and long-term site performance.",

    features: [
      "Detention Systems",
      "Drainage Analysis",
      "Hydraulic Calculations",
      "Stormwater Reports"
    ]
  },

  {
    category: "Municipal",
    title: "Municipal Infrastructure",
    location: "New Jersey",
    image: "/projects/project-municipal.png",

    description:
      "Engineering support for roadway improvements, drainage systems and public infrastructure projects.",

    features: [
      "Roadway Design",
      "Drainage Improvements",
      "Utility Coordination",
      "Construction Support"
    ]
  },

  {
    category: "Land Development",
    title: "Subdivision & Land Development",
    location: "New Jersey",
    image: "/projects/project-subdivision.png",

    description:
      "Planning and engineering services supporting residential and commercial land development projects.",

    features: [
      "Subdivision Design",
      "Site Layout",
      "Utility Planning",
      "Agency Approvals"
    ]
  },

  {
    category: "Construction",
    title: "Construction Phase Services",
    location: "New Jersey",
    image: "/projects/project-construction.png",

    description:
      "Engineering assistance throughout construction to support efficient project delivery.",

    features: [
      "Field Support",
      "Plan Revisions",
      "Contractor Coordination",
      "Final Certifications"
    ]
  }
];
---

<Layout
  title="Engineering Projects | MIDRA Engineering"
  description="Representative civil engineering projects completed by MIDRA Engineering for residential, commercial, municipal and land development clients."
>

<PageHero
  title="Our Projects"
  subtitle="Representative Engineering Projects Demonstrating Practical Design, Technical Quality and Reliable Project Delivery."
/>

<section class="projects-page">

<div class="container">

<div class="projects-intro">

<span>

OUR PROJECTS

</span>

<h2>

Engineering
Solutions
Delivered

</h2>

<p>

The following representative projects demonstrate the types of
civil engineering services MIDRA Engineering provides. These
placeholders will be replaced with completed project photography
and descriptions as our portfolio continues to grow.

</p>

</div>

<div class="projects-grid">

{

projects.map((project) => (

<article class="project-card">
<div class="project-image">

  <img
    src={project.image}
    alt={project.title}
    loading="lazy"
  />

  <div class="project-category">

    {project.category}

  </div>

</div>

<div class="project-content">

  <div class="project-location">

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >

      <path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0"></path>

      <circle
        cx="12"
        cy="10"
        r="3"
      ></circle>

    </svg>

    {project.location}

  </div>

  <h3>

    {project.title}

  </h3>

  <p>

    {project.description}

  </p>

  <ul>

    {

      project.features.map((feature) => (

        <li>

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >

            <polyline points="20 6 9 17 4 12"></polyline>

          </svg>

          {feature}

        </li>

      ))

    }

  </ul>

  <a
    href="/contact"
    class="project-button"
  >

    Request Proposal

  </a>

</div>

</article>

))

}

</div>

</div>

</section>

<CTA />

<style>
.projects-page{

    padding:120px 0;

    background:#FFFFFF;

}

.projects-intro{

    max-width:760px;

    margin:0 auto 72px;

    text-align:center;

}

.projects-intro span{

    display:inline-block;

    margin-bottom:20px;

    color:#C89B3C;

    font-size:.82rem;

    font-weight:700;

    letter-spacing:.18em;

    text-transform:uppercase;

}

.projects-intro h2{

    margin-bottom:24px;

    color:#08295E;

}

.projects-intro p{

    max-width:700px;

    margin:0 auto;

    line-height:1.9;

}

.projects-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:32px;

}

.project-card{

    display:flex;

    flex-direction:column;

    overflow:hidden;

    background:#FFFFFF;

    border:1px solid #E5E7EB;

    border-radius:20px;

    transition:

        border-color .25s ease,

        box-shadow .25s ease;

}

.project-card:hover{

    border-color:#C89B3C;

    box-shadow:0 12px 30px rgba(8,41,94,.08);

}

.project-image{

    position:relative;

    aspect-ratio:16/9;

    overflow:hidden;

    background:#F3F4F6;

}

.project-image img{

    width:100%;

    height:100%;

    object-fit:cover;

}

.project-category{

    position:absolute;

    top:20px;

    left:20px;

    padding:8px 16px;

    background:#08295E;

    color:#FFFFFF;

    border-radius:999px;

    font-size:.72rem;

    font-weight:700;

    letter-spacing:.08em;

    text-transform:uppercase;

}

.project-content{

    display:flex;

    flex-direction:column;

    flex:1;

    padding:34px;

}

.project-location{

    display:flex;

    align-items:center;

    gap:10px;

    margin-bottom:18px;

    color:#C89B3C;

    font-size:.9rem;

    font-weight:600;

}

.project-location svg{

    width:18px;

    height:18px;

    flex-shrink:0;

}

.project-content h3{

    margin-bottom:18px;

    color:#08295E;

}

.project-content p{

    margin-bottom:28px;

    line-height:1.8;

}

.project-content ul{

    display:grid;

    gap:14px;

    margin-bottom:32px;

    list-style:none;

}

.project-content li{

    display:flex;

    align-items:center;

    gap:12px;

}

.project-content li svg{

    width:18px;

    height:18px;

    color:#C89B3C;

    flex-shrink:0;

}

.project-button{

    margin-top:auto;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-height:48px;

    padding:0 24px;

    border-radius:999px;

    background:#08295E;

    color:#FFFFFF;

    font-weight:600;

    transition:

        background-color .25s ease,

        box-shadow .25s ease;

}

.project-button:hover{

    background:#103A7A;

    box-shadow:0 10px 24px rgba(8,41,94,.16);

}
@media (max-width:1100px){

    .projects-grid{

        grid-template-columns:1fr;

        gap:28px;

    }

}

@media (max-width:768px){

    .projects-page{

        padding:90px 0;

    }

    .projects-intro{

        margin-bottom:56px;

    }

    .project-content{

        padding:30px;

    }

    .project-image{

        aspect-ratio:4/3;

    }

}

@media (max-width:480px){

    .projects-page{

        padding:72px 0;

    }

    .projects-intro{

        margin-bottom:48px;

    }

    .projects-intro span{

        font-size:.72rem;

        letter-spacing:.16em;

    }

    .project-card{

        border-radius:18px;

    }

    .project-content{

        padding:24px;

    }

    .project-content h3{

        font-size:1.35rem;

    }

    .project-location{

        font-size:.85rem;

    }

    .project-button{

        width:100%;

    }

}
</style>

</Layout>