---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";

const projects = [
  {
    category: "Residential",
    title: "Custom Residential Site Development",
    description:
      "Complete civil engineering services for custom homes including grading, drainage, utility coordination, stormwater management, and municipal permitting.",
    image: "/projects/project-residential.png"
  },
  {
    category: "Commercial",
    title: "Commercial Property Development",
    description:
      "Site engineering for retail, office, industrial, and mixed-use developments with practical, code-compliant design solutions.",
    image: "/projects/project-commercial.png"
  },
  {
    category: "Stormwater",
    title: "Stormwater Management Systems",
    description:
      "NJDEP-compliant stormwater design including detention basins, infiltration systems, drainage analysis, and hydraulic modeling.",
    image: "/projects/project-stormwater.png"
  },
  {
    category: "Municipal",
    title: "Municipal Infrastructure",
    description:
      "Engineering support for roadway improvements, drainage upgrades, utility improvements, and public infrastructure projects.",
    image: "/projects/project-municipal.png"
  },
  {
    category: "Land Development",
    title: "Subdivision & Land Development",
    description:
      "Planning and engineering for residential subdivisions and land development projects from concept through approvals.",
    image: "/projects/project-subdivision.png"
  },
  {
    category: "Construction",
    title: "Construction Phase Services",
    description:
      "Engineering support during construction including field coordination, design clarification, and agency responses.",
    image: "/projects/project-construction.png"
  }
];
---

<Layout
title="Engineering Projects | MIDRA Engineering"
description="Explore the residential, commercial, municipal, and stormwater engineering projects completed by MIDRA Engineering throughout New Jersey."
>

<PageHero
title="Our Projects"
subtitle="Engineering Solutions That Transform Ideas Into Successful Projects."
/>

<section class="projects-page">

<div class="background-grid"></div>
<div class="background-glow"></div>

<div class="container">

<div class="projects-intro">

<span>

OUR EXPERIENCE

</span>

<h2>

Projects Built
With Precision,
Planning &
Performance

</h2>

<p>

Every project is different, but our approach
remains the same: thoughtful engineering,
clear communication, and practical solutions
that move projects efficiently from concept
through construction.

</p>

</div>

<div class="projects-grid">

{

projects.map(project => (

<article class="project-card">

<div class="project-image">

<img
src={project.image}
alt={project.title}
loading="lazy"
/>

<div class="project-category">

{project.category}

</div>

</div>

<div class="project-content">

<h3>

{project.title}

</h3>

<p>

{project.description}

</p>

<a
href="/contact"
class="project-link"
>

Discuss a Similar Project

<span>

→

</span>

</a>

</div>

</article>

))

}

</div>

</div>

</section>

<CTA />

<style>

.projects-page{

position:relative;

overflow:hidden;

padding:130px 0;

background:

linear-gradient(
180deg,
#F8FAFC,
#FFFFFF
);

}

.background-grid{

position:absolute;

inset:0;

opacity:.18;

background-image:

linear-gradient(
rgba(14,58,93,.05) 1px,
transparent 1px
),

linear-gradient(
90deg,
rgba(14,58,93,.05) 1px,
transparent 1px
);

background-size:60px 60px;

pointer-events:none;

}

.background-glow{

position:absolute;

right:-260px;

top:-220px;

width:650px;

height:650px;

border-radius:50%;

background:

radial-gradient(
circle,
rgba(198,161,91,.10),
transparent 72%
);

pointer-events:none;

}

.projects-intro{

position:relative;

z-index:2;

max-width:760px;

margin:0 auto 75px;

text-align:center;

}

.projects-intro span{

display:inline-flex;

align-items:center;

padding:10px 18px;

background:white;

border:1px solid rgba(14,58,93,.08);

border-radius:999px;

font-size:.78rem;

font-weight:800;

letter-spacing:.14em;

text-transform:uppercase;

color:#0E3A5D;

margin-bottom:24px;

box-shadow:

0 14px 35px rgba(0,0,0,.05);

}
.projects-intro h2{

font-size:clamp(
2.8rem,
5vw,
4.2rem
);

font-weight:800;

line-height:1.06;

letter-spacing:-.03em;

color:#16324A;

margin:0 0 24px;

text-wrap:balance;

}

.projects-intro p{

max-width:700px;

margin:0 auto;

font-size:1.08rem;

line-height:1.95;

color:#66707C;

}

.projects-grid{

position:relative;

z-index:2;

display:grid;

grid-template-columns:

repeat(2,1fr);

gap:36px;

}

.project-card{

display:flex;

flex-direction:column;

height:100%;

background:white;

border-radius:28px;

overflow:hidden;

border:1px solid #EEF2F6;

box-shadow:

0 18px 45px rgba(15,58,93,.06);

transition:

transform .35s ease,
box-shadow .35s ease,
border-color .35s ease;

}

.project-card:hover{

transform:translateY(-10px);

border-color:

rgba(198,161,91,.30);

box-shadow:

0 32px 70px rgba(15,58,93,.12);

}

.project-image{

position:relative;

height:260px;

overflow:hidden;

}

.project-image img{

display:block;

width:100%;

height:100%;

object-fit:cover;

transition:

transform .5s ease;

}

.project-card:hover .project-image img{

transform:scale(1.06);

}

.project-category{

position:absolute;

top:22px;

left:22px;

display:inline-flex;

align-items:center;

justify-content:center;

padding:10px 18px;

background:

rgba(14,58,93,.92);

color:white;

font-size:.78rem;

font-weight:800;

letter-spacing:.08em;

text-transform:uppercase;

border-radius:999px;

backdrop-filter:blur(10px);

}

.project-content{

display:flex;

flex-direction:column;

flex:1;

padding:36px;

}

.project-content h3{

margin:0 0 18px;

font-size:1.55rem;

font-weight:800;

line-height:1.3;

color:#16324A;

}

.project-content p{

flex:1;

margin:0 0 28px;

font-size:1rem;

line-height:1.9;

color:#66707C;

}

.project-link{

display:inline-flex;

align-items:center;

gap:10px;

font-weight:700;

text-decoration:none;

color:#0E3A5D;

transition:

color .3s ease,
gap .3s ease;

}

.project-link span{

transition:

transform .3s ease;

}

.project-link:hover{

gap:16px;

color:#C6A15B;

}

.project-link:hover span{

transform:translateX(6px);

}
@media (max-width:1100px){

.projects-page{

padding:110px 0;

}

.projects-grid{

grid-template-columns:1fr;

}

}

@media (max-width:768px){

.projects-page{

padding:90px 0;

}

.projects-intro{

margin-bottom:55px;

}

.projects-intro h2{

font-size:2.5rem;

}

.projects-intro p{

font-size:1rem;

}

.project-image{

height:220px;

}

.project-content{

padding:30px;

}

}

@media (max-width:480px){

.projects-page{

padding:80px 0;

}

.projects-intro span{

font-size:.68rem;

padding:8px 14px;

}

.projects-intro h2{

font-size:2rem;

}

.project-image{

height:200px;

}

.project-content{

padding:24px;

}

.project-content h3{

font-size:1.35rem;

}

}

</style>

</Layout>